+static char *parse_cmd_args(char *str, int *argc, char *argv[10])
+{
+	char *token;
+	int i = 0;
+	char *copy = kstrdup(str, GFP_KERNEL);
+	char *tmp = copy;
+
+	if (!copy) {
+		*argc = 0;
+		return NULL;
+	}
+
+	while ((token = strsep(&tmp, " ")) != NULL) {
+		if (i == 10)
+			break;
+		argv[i] = token;
+		i++;
+	}
+	*argc = i;
+
+	return copy;
+}
