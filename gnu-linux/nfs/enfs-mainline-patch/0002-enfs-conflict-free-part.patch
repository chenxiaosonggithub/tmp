+	struct rpc_xprt *pos;
+	struct enfs_xprt_context *context;
+	char buf[128];
+	bool matched;
+
+	if (argc > 1) {
+		enfs_log_info("argc number is wrong.\n");
+		return;
+	}
+
+	read_lock(&shard_ctrl->clnt_info_lock);
+	list_for_each_entry(info, &shard_ctrl->clnt_info_list, next) {
+		clnt = info->clnt;
