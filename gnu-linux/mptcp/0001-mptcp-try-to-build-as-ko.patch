diff --git a/net/mptcp-adapter.c b/net/mptcp-adapter.c
new file mode 100644
index 000000000000..b9b8400bd653
--- /dev/null
+++ b/net/mptcp-adapter.c
@@ -0,0 +1,69 @@
+// #include <linux/kernel.h>
+#include <linux/net.h>
+#include <linux/module.h>
+#include <net/mptcp.h>
+#include <mptcp-adapter.h>
+
+#define MPTCP_ADAPTER_DEBUG	0
+
+#if !defined(MPTCP_ADAPTER_DEBUG)
+// 调试用途，不考虑并发
+static struct mptcp_operations *mptcp_adapter_op = NULL;
+#else // MPTCP_ADAPTER_DEBUG
+static struct mptcp_sock *dbg_bpf_mptcp_sock_from_subflow(struct sock *sk)
+{
+	mydebug_print("\n");
+	return NULL;
+}
+
+static bool dbg_mptcp_incoming_options(struct sock *sk, struct sk_buff *skb)
+{
+	mydebug_print("\n");
+	return true;
+}
+
+static struct mptcp_operations dbg_mptcp_adapter_op = {
+	.bpf_mptcp_sock_from_subflow = dbg_bpf_mptcp_sock_from_subflow,
+	.mptcp_incoming_options = dbg_mptcp_incoming_options,
+};
+
+static struct mptcp_operations *mptcp_adapter_op = &dbg_mptcp_adapter_op;
+#endif // MPTCP_ADAPTER_DEBUG
+
+inline __be32 mptcp_reset_option(const struct sk_buff *skb)
+{
+	struct mptcp_operations *op = mptcp_adapter_get_op();
+	if (skb_ext_exist(skb, SKB_EXT_MPTCP))
+		return op->mptcp_get_reset_option(skb);
+
+	return htonl(0u);
+}
+
+struct mptcp_operations *mptcp_adapter_get_op(void)
+{
+	int res;
+	if (!mptcp_adapter_op) {
+		res = request_module("enfs");
+		if (res) {
+			mydebug_print("request_module err: %d\n", res);
+			return NULL;
+		}
+	}
+	return mptcp_adapter_op;
+}
+EXPORT_SYMBOL(mptcp_adapter_get_op);
+
+int mptcp_adapter_register(struct mptcp_operations *op)
+{
+	mptcp_adapter_op = op;
+	return 0;
+}
+EXPORT_SYMBOL(mptcp_adapter_register);
+
+int mptcp_adapter_unregister(void)
+{
+	mptcp_adapter_op = NULL;
+	return 0;
+}
+EXPORT_SYMBOL(mptcp_adapter_unregister);
+
