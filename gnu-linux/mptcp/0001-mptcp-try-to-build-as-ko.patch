@@ -0,0 +1,37 @@
+#ifndef _MPTCP_ADAPTER_H
+#define _MPTCP_ADAPTER_H
+#include <mydebug.h>
+
+struct mptcp_operations {
+	struct module *owner;
+	struct mptcp_sock * (*bpf_mptcp_sock_from_subflow) (struct sock *sk);
+	bool (*mptcp_incoming_options) (struct sock *sk, struct sk_buff *skb);
+	bool (*mptcp_established_options) (struct sock *sk, struct sk_buff *skb,
+					   unsigned int *size, unsigned int remaining,
+					   struct mptcp_out_options *opts);
+	bool (*mptcp_synack_options) (const struct request_sock *req, unsigned int *size,
+				     struct mptcp_out_options *opts);
+	bool (*mptcp_syn_options) (struct sock *sk, const struct sk_buff *skb,
+				  unsigned int *size, struct mptcp_out_options *opts);
+	void (*mptcp_write_options) (struct tcphdr *th, __be32 *ptr, struct tcp_sock *tp,
+				    struct mptcp_out_options *opts);
+	void (*mptcp_space) (const struct sock *ssk, int *space, int *full_space);
+	void (*mptcp_active_detect_blackhole) (struct sock *ssk, bool expired);
+	__be32 (*mptcp_get_reset_option) (const struct sk_buff *skb);
+	void (*mptcp_seq_show) (struct seq_file *seq);
+	int (*mptcp_subflow_init_cookie_req) (struct request_sock *req,
+					     const struct sock *sk_listener,
+					     struct sk_buff *skb);
+	struct request_sock * (*mptcp_subflow_reqsk_alloc) (const struct request_sock_ops *ops,
+							   struct sock *sk_listener,
+							   bool attach_listener);
+	void (*mptcpv6_handle_mapped) (struct sock *sk, bool mapped);
+	void (*mptcp_init) (void);
+	int (*mptcpv6_init) (void);
+};
+
+struct mptcp_operations *mptcp_adapter_get_op(void);
+int mptcp_adapter_register(struct mptcp_operations *op);
+int mptcp_adapter_unregister(void);
+
+#endif /*_MPTCP_ADAPTER_H */
