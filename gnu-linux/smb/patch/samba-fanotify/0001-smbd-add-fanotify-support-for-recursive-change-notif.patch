From 9ce2c6632a4e7f1d5c5e3f5291fe984df15485e9 Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Thu, 3 Sep 2026 08:36:22 +0800
Subject: [PATCH] smbd: add fanotify support for recursive change notify

The inotify backend only watches the requested directory, so recursive
SMB2 CHANGE_NOTIFY requests miss local changes made in descendant
directories.

Add a fanotify backend using filesystem marks and file handle records
to obtain the full path of an event. Apply the direct and recursive
completion filters according to the event's location below the watched
directory.

Ignore events generated by Samba processes because those changes are
already propagated through notifyd. This avoids duplicate notifications
and preserves the directory lease handling of internally generated
events.

Prefer fanotify when available and fall back to inotify if fanotify
initialization or filesystem marking is unsupported.

Signed-off-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 lib/replace/wscript            |   2 +
 source3/smbd/notify_fanotify.c | 676 +++++++++++++++++++++++++++++++++
 source3/smbd/proto.h           |  14 +
 source3/smbd/server.c          |   9 +-
 source3/wscript                |  16 +
 source3/wscript_build          |   5 +-
 6 files changed, 720 insertions(+), 2 deletions(-)
 create mode 100644 source3/smbd/notify_fanotify.c

diff --git a/lib/replace/wscript b/lib/replace/wscript
index 2ea7d61459f..acd0632fba0 100644
--- a/lib/replace/wscript
+++ b/lib/replace/wscript
@@ -90,6 +90,8 @@ def configure(conf):
 
     conf.CHECK_FUNCS_IN('inotify_init', 'inotify', checklibc=True,
                         headers='sys/inotify.h')
+    conf.CHECK_FUNCS_IN('fanotify_init', 'fanotify', checklibc=True,
+                        headers='sys/fanotify.h')
 
     conf.CHECK_HEADERS('security/pam_appl.h zlib.h asm/unistd.h')
     conf.CHECK_HEADERS('sys/unistd.h alloca.h float.h')
diff --git a/source3/smbd/notify_fanotify.c b/source3/smbd/notify_fanotify.c
new file mode 100644
index 00000000000..e57f4b64799
--- /dev/null
+++ b/source3/smbd/notify_fanotify.c
@@ -0,0 +1,676 @@
