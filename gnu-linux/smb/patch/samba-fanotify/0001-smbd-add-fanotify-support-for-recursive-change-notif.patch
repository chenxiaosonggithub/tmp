+#include "includes.h"
+#include "../librpc/gen_ndr/notify.h"
+#include "smbd/smbd.h"
+#include "lib/util/sys_rw.h"
+#include "lib/messaging/messages_dgm.h"
+
+#include <sys/fanotify.h>
+
+#define FANOTIFY_CHANGE_MASK \
+	(FAN_CREATE | FAN_DELETE | FAN_MOVED_FROM | FAN_MOVED_TO | \
+	 FAN_ATTRIB | FAN_CLOSE_WRITE | FAN_ONDIR | FAN_EVENT_ON_CHILD)
+
+#define FANOTIFY_NAME_MASK \
+	(FAN_CREATE | FAN_DELETE | FAN_MOVED_FROM | FAN_MOVED_TO)
+
+#define FANOTIFY_SUPPORTED_FILTER \
+	(FILE_NOTIFY_CHANGE_FILE_NAME | FILE_NOTIFY_CHANGE_DIR_NAME | \
+	 FILE_NOTIFY_CHANGE_ATTRIBUTES | FILE_NOTIFY_CHANGE_SIZE | \
+	 FILE_NOTIFY_CHANGE_LAST_WRITE | FILE_NOTIFY_CHANGE_LAST_ACCESS | \
+	 FILE_NOTIFY_CHANGE_CREATION | FILE_NOTIFY_CHANGE_EA | \
+	 FILE_NOTIFY_CHANGE_SECURITY)
+
+struct fanotify_private;
+
+struct fanotify_watch_context {
+	struct fanotify_watch_context *next, *prev;
+	struct fanotify_private *in;
+	int mount_fd;
+	void (*callback)(struct sys_notify_context *ctx,
+			 void *private_data,
+			 struct notify_event *ev,
+			 uint32_t filter);
+	void *private_data;
+	uint32_t filter;
+	uint32_t subdir_filter;
+	char *path;
+	char *canonical_path;
+};
+
+struct fanotify_private {
+	struct sys_notify_context *ctx;
+	struct sys_notify_context *fallback_ctx;
+	struct fanotify_watch_context *watches;
+	int fd;
+	int init_error;
+};
+
+struct fanotify_fid {
+	const struct file_handle *handle;
+	const char *name;
+};
+
+struct fanotify_dispatch_path {
+	struct fanotify_dispatch_path *next, *prev;
+	void (*callback)(struct sys_notify_context *ctx,
+			 void *private_data,
+			 struct notify_event *ev,
+			 uint32_t filter);
+	void *private_data;
+	char *full_path;
+	uint32_t filter;
+};
+
+static void fanotify_handler(struct tevent_context *ev,
+			     struct tevent_fd *fde,
+			     uint16_t flags,
+			     void *private_data);
+
+static int fanotify_private_destructor(struct fanotify_private *in)
+{
+	if (in->fd != -1) {
+		close(in->fd);
+	}
+	return 0;
+}
+
+static int fanotify_setup(struct sys_notify_context *ctx)
+{
+	struct fanotify_private *in = NULL;
+	struct tevent_fd *fde = NULL;
+	int fd;
+
+	in = talloc_zero(ctx, struct fanotify_private);
+	if (in == NULL) {
+		return ENOMEM;
+	}
+
+	in->ctx = ctx;
+	in->fd = -1;
+	talloc_set_destructor(in, fanotify_private_destructor);
+	ctx->private_data = in;
+
+	fd = fanotify_init(FAN_CLASS_NOTIF | FAN_CLOEXEC | FAN_NONBLOCK |
+			   FAN_REPORT_DFID_NAME | FAN_REPORT_FID,
+			   O_RDONLY | O_CLOEXEC | O_LARGEFILE);
+	if (fd == -1) {
+		in->init_error = errno;
+		DBG_NOTICE("fanotify_init failed: %s; falling back to inotify\n",
+			   strerror(in->init_error));
+		return 0;
+	}
+
+	in->fd = fd;
+	fde = tevent_add_fd(ctx->ev,
+			    in,
+			    in->fd,
+			    TEVENT_FD_READ,
+			    fanotify_handler,
+			    in);
+	if (fde == NULL) {
+		in->init_error = ENOMEM;
+		close(in->fd);
+		in->fd = -1;
+		return 0;
+	}
+
+	return 0;
+}
+
+static int fanotify_fallback_watch(
+	TALLOC_CTX *mem_ctx,
+	struct fanotify_private *in,
+	const char *path,
+	uint32_t *filter,
+	uint32_t *subdir_filter,
+	void (*callback)(struct sys_notify_context *ctx,
+			 void *private_data,
+			 struct notify_event *ev,
+			 uint32_t filter),
+	void *private_data,
+	void *handle_p,
+	int fanotify_error)
+{
+#ifdef HAVE_INOTIFY
+	if (in->fallback_ctx == NULL) {
+		in->fallback_ctx = sys_notify_context_create(in, in->ctx->ev);
+		if (in->fallback_ctx == NULL) {
+			return ENOMEM;
+		}
+	}
+
+	DBG_NOTICE("fanotify watch for [%s] is unavailable: %s; "
+		   "falling back to inotify\n",
+		   path,
+		   strerror(fanotify_error));
+
+	return inotify_watch(mem_ctx,
+			     in->fallback_ctx,
+			     path,
+			     filter,
+			     subdir_filter,
+			     callback,
+			     private_data,
+			     handle_p);
+#else
+	return fanotify_error;
+#endif
+}
+
+static bool fanotify_pid_is_samba(pid_t pid)
+{
+	uint64_t unique;
+	int ret;
+
+	if (pid <= 0) {
+		return false;
+	}
+
+	ret = messaging_dgm_get_unique(pid, &unique);
+	return (ret == 0) || (ret == EACCES);
+}
+
+static uint32_t fanotify_mask_to_filter(uint64_t mask)
+{
+	uint32_t filter = 0;
+
+	if (mask & FANOTIFY_NAME_MASK) {
+		if (mask & FAN_ONDIR) {
+			filter |= FILE_NOTIFY_CHANGE_DIR_NAME;
+		} else {
+			filter |= FILE_NOTIFY_CHANGE_FILE_NAME;
+		}
+	}
+
+	if (mask & FAN_ATTRIB) {
+		filter |= FILE_NOTIFY_CHANGE_ATTRIBUTES |
+			  FILE_NOTIFY_CHANGE_LAST_WRITE |
+			  FILE_NOTIFY_CHANGE_LAST_ACCESS |
+			  FILE_NOTIFY_CHANGE_CREATION |
+			  FILE_NOTIFY_CHANGE_EA |
+			  FILE_NOTIFY_CHANGE_SECURITY;
+	}
+
+	if (mask & FAN_CLOSE_WRITE) {
+		filter |= FILE_NOTIFY_CHANGE_ATTRIBUTES |
+			  FILE_NOTIFY_CHANGE_SIZE |
+			  FILE_NOTIFY_CHANGE_LAST_WRITE;
+	}
+
+	return filter;
+}
+
+static uint32_t fanotify_mask_to_action(uint64_t mask)
+{
+	if (mask & (FAN_CREATE | FAN_MOVED_TO)) {
+		return NOTIFY_ACTION_ADDED;
+	}
+	if (mask & (FAN_DELETE | FAN_MOVED_FROM)) {
+		return NOTIFY_ACTION_REMOVED;
+	}
+	return NOTIFY_ACTION_MODIFIED;
+}
+
+static bool fanotify_event_get_fid(
+	const struct fanotify_event_metadata *metadata,
+	struct fanotify_fid *result)
+{
+	const uint8_t *event_end =
+		(const uint8_t *)metadata + metadata->event_len;
+	const struct fanotify_event_info_header *hdr = NULL;
+
+	*result = (struct fanotify_fid) { .handle = NULL, .name = NULL };
+
+	if (metadata->metadata_len > metadata->event_len) {
+		return false;
+	}
+
+	hdr = (const struct fanotify_event_info_header *)
+		((const uint8_t *)metadata + metadata->metadata_len);
+
+	while (((const uint8_t *)hdr + sizeof(*hdr)) <= event_end) {
+		const struct fanotify_event_info_fid *fid = NULL;
+		const struct file_handle *handle = NULL;
+		size_t handle_offset =
+			offsetof(struct fanotify_event_info_fid, handle);
+		size_t handle_size;
+
+		if ((hdr->len < sizeof(*hdr)) ||
+		    ((const uint8_t *)hdr + hdr->len > event_end)) {
+			return false;
+		}
+
+		if ((hdr->info_type != FAN_EVENT_INFO_TYPE_FID) &&
+		    (hdr->info_type != FAN_EVENT_INFO_TYPE_DFID_NAME)) {
+			goto next;
+		}
+
+		if (hdr->len < handle_offset + sizeof(*handle)) {
+			return false;
+		}
+
+		fid = (const struct fanotify_event_info_fid *)hdr;
+		handle = (const struct file_handle *)fid->handle;
+		if (handle->handle_bytes >
+		    hdr->len - handle_offset - sizeof(*handle)) {
+			return false;
+		}
+		handle_size = sizeof(*handle) + handle->handle_bytes;
+
+		if (hdr->info_type == FAN_EVENT_INFO_TYPE_DFID_NAME) {
+			const char *name =
+				(const char *)handle + handle_size;
+			size_t name_space = hdr->len - handle_offset - handle_size;
+
+			if (memchr(name, '\0', name_space) == NULL) {
+				return false;
+			}
+			result->handle = handle;
+			result->name = name;
+			return true;
+		}
+
+		if (result->handle == NULL) {
+			result->handle = handle;
+		}
+
+next:
+		hdr = (const struct fanotify_event_info_header *)
+			((const uint8_t *)hdr + hdr->len);
+	}
+
+	return result->handle != NULL;
+}
+
+static char *fanotify_event_path(
+	TALLOC_CTX *mem_ctx,
+	const struct fanotify_watch_context *w,
+	const struct fanotify_fid *fid)
+{
+	char proc_path[64];
+	char path[PATH_MAX + 1];
+	ssize_t path_len;
+	int fd;
+
+	fd = open_by_handle_at(w->mount_fd,
+			       discard_const_p(struct file_handle, fid->handle),
+			       O_PATH | O_CLOEXEC);
+	if (fd == -1) {
+		return NULL;
+	}
+
+	snprintf(proc_path, sizeof(proc_path), "/proc/self/fd/%d", fd);
+	path_len = readlink(proc_path, path, sizeof(path) - 1);
+	close(fd);
+	if (path_len == -1) {
+		return NULL;
+	}
+	if (path_len == (sizeof(path) - 1)) {
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+	path[path_len] = '\0';
+
+	if (fid->name == NULL) {
+		return talloc_strdup(mem_ctx, path);
+	}
+
+	return talloc_asprintf(mem_ctx,
+			       "%s%s%s",
+			       path,
+			       strequal(path, "/") ? "" : "/",
+			       fid->name);
+}
+
+static bool fanotify_path_below(
+	const struct fanotify_watch_context *w,
+	const char *event_path,
+	const char **relative_path)
+{
+	size_t root_len = strlen(w->canonical_path);
+
+	if (strequal(w->canonical_path, "/")) {
+		if (event_path[0] != '/') {
+			return false;
+		}
+		*relative_path = event_path + 1;
+		return (*relative_path)[0] != '\0';
+	}
+
+	if (strncmp(event_path, w->canonical_path, root_len) != 0) {
+		return false;
+	}
+	if (event_path[root_len] != '/') {
+		return false;
+	}
+
+	*relative_path = event_path + root_len + 1;
+	return (*relative_path)[0] != '\0';
+}
+
+static bool fanotify_dispatch_path_exists(
+	struct fanotify_dispatch_path *paths,
+	const struct fanotify_watch_context *w,
+	const char *full_path,
+	uint32_t filter)
+{
+	struct fanotify_dispatch_path *p = NULL;
+
+	for (p = paths; p != NULL; p = p->next) {
+		if ((p->callback != w->callback) ||
+		    (p->private_data != w->private_data) ||
+		    !strequal(p->full_path, full_path)) {
+			continue;
+		}
+		p->filter |= filter;
+		return true;
+	}
+	return false;
+}
+
+static void fanotify_dispatch(
+	struct fanotify_private *in,
+	const struct fanotify_event_metadata *metadata)
+{
+	struct fanotify_watch_context *w = NULL;
+	struct fanotify_fid fid = {};
+	struct fanotify_dispatch_path *paths = NULL;
+	struct fanotify_dispatch_path *p = NULL;
+	TALLOC_CTX *frame = NULL;
+	uint32_t filter;
+	uint32_t action;
+
+	DBG_DEBUG("fanotify event mask=%"PRIx64" pid=%jd\n",
+		  (uint64_t)metadata->mask,
+		  (intmax_t)metadata->pid);
+
+	if (metadata->mask & FAN_Q_OVERFLOW) {
+		DBG_WARNING("fanotify queue overflowed\n");
+		return;
+	}
+
+	if (fanotify_pid_is_samba(metadata->pid)) {
+		/*
+		 * smbd sends a richer notify_trigger message for its own changes.
+		 * Ignoring the kernel copy avoids duplicate notifications and lets
+		 * the SMB request path exclude the originating directory lease.
+		 */
+		DBG_DEBUG("ignoring event from Samba pid %jd\n",
+			  (intmax_t)metadata->pid);
+		return;
+	}
+
+	filter = fanotify_mask_to_filter(metadata->mask);
+	if (filter == 0) {
+		return;
+	}
+	if (!fanotify_event_get_fid(metadata, &fid)) {
+		DBG_DEBUG("fanotify event did not contain a usable file handle\n");
+		return;
+	}
+
+	frame = talloc_stackframe();
+
+	for (w = in->watches; w != NULL; w = w->next) {
+		const char *relative_path = NULL;
+		const char *slash = NULL;
+		char *event_path = NULL;
+		char *full_path = NULL;
+		uint32_t requested_filter;
+
+		event_path = fanotify_event_path(frame, w, &fid);
+		if (event_path == NULL) {
+			DBG_DEBUG("could not resolve fanotify event for [%s]: %s\n",
+				  w->canonical_path,
+				  strerror(errno));
+			continue;
+		}
+		DBG_DEBUG("resolved fanotify event path [%s]\n", event_path);
+		if (!fanotify_path_below(w, event_path, &relative_path)) {
+			continue;
+		}
+
+		slash = strchr(relative_path, '/');
+		requested_filter = (slash == NULL) ? w->filter
+						  : w->subdir_filter;
+		if ((requested_filter & filter) == 0) {
+			continue;
+		}
+
+		full_path = talloc_asprintf(frame,
+					    "%s%s%s",
+					    w->path,
+					    strequal(w->path, "/") ? "" : "/",
+					    relative_path);
+		if (full_path == NULL) {
+			continue;
+		}
+
+		if (fanotify_dispatch_path_exists(
+			    paths, w, full_path, filter)) {
+			continue;
+		}
+
+		p = talloc_zero(frame, struct fanotify_dispatch_path);
+		if (p == NULL) {
+			continue;
+		}
+		p->callback = w->callback;
+		p->private_data = w->private_data;
+		p->full_path = full_path;
+		p->filter = filter;
+		DLIST_ADD_END(paths, p);
+	}
+
+	action = fanotify_mask_to_action(metadata->mask);
+	for (p = paths; p != NULL; p = p->next) {
+		struct notify_event ne = { .action = action };
+		char *slash = strrchr(p->full_path, '/');
+
+		if (slash == NULL) {
+			continue;
+		}
+		ne.dir = talloc_strndup(frame,
+					p->full_path,
+					slash - p->full_path);
+		ne.path = slash + 1;
+		if (ne.dir == NULL) {
+			continue;
+		}
+		if (ne.dir[0] == '\0') {
+			ne.dir = "/";
+		}
+
+		p->callback(in->ctx,
+			    p->private_data,
+			    &ne,
+			    p->filter);
+	}
+
+	TALLOC_FREE(frame);
+}
+
+static void fanotify_handler(struct tevent_context *ev,
+			     struct tevent_fd *fde,
+			     uint16_t flags,
+			     void *private_data)
+{
+	struct fanotify_private *in = talloc_get_type_abort(
+		private_data, struct fanotify_private);
+	char buf[64 * 1024] __attribute__((aligned(8)));
+	ssize_t len;
+	struct fanotify_event_metadata *metadata = NULL;
+
+	len = sys_read(in->fd, buf, sizeof(buf));
+	if (len == -1) {
+		if ((errno == EAGAIN) || (errno == EINTR)) {
+			return;
+		}
+		DBG_ERR("reading fanotify events failed: %s\n", strerror(errno));
+		TALLOC_FREE(fde);
+		return;
+	}
+
+	metadata = (struct fanotify_event_metadata *)buf;
+	while (FAN_EVENT_OK(metadata, len)) {
+		if (metadata->vers != FANOTIFY_METADATA_VERSION) {
+			DBG_ERR("fanotify metadata version mismatch: %u != %u\n",
+				metadata->vers,
+				FANOTIFY_METADATA_VERSION);
+			TALLOC_FREE(fde);
+			return;
+		}
+
+		fanotify_dispatch(in, metadata);
+		if (metadata->fd >= 0) {
+			close(metadata->fd);
+		}
+		metadata = FAN_EVENT_NEXT(metadata, len);
+	}
+}
+
+static int fanotify_watch_destructor(struct fanotify_watch_context *w)
+{
+	DLIST_REMOVE(w->in->watches, w);
+	close(w->mount_fd);
+	return 0;
+}
+
+int fanotify_watch(TALLOC_CTX *mem_ctx,
+		   struct sys_notify_context *ctx,
+		   const char *path,
+		   uint32_t *filter,
+		   uint32_t *subdir_filter,
+		   void (*callback)(struct sys_notify_context *ctx,
+				    void *private_data,
+				    struct notify_event *ev,
+				    uint32_t filter),
+		   void *private_data,
+		   void *handle_p)
+{
+	struct fanotify_private *in = NULL;
+	struct fanotify_watch_context *w = NULL;
+	char *canonical_path = NULL;
+	void **handle = (void **)handle_p;
+	int ret;
+
+	if (ctx->private_data == NULL) {
+		ret = fanotify_setup(ctx);
+		if (ret != 0) {
+			return ret;
+		}
+	}
+
+	in = talloc_get_type_abort(ctx->private_data, struct fanotify_private);
+	if (in->fd == -1) {
+		return fanotify_fallback_watch(mem_ctx,
+					       in,
+					       path,
+					       filter,
+					       subdir_filter,
+					       callback,
+					       private_data,
+					       handle_p,
+					       in->init_error);
+	}
+
+	if (((*filter | *subdir_filter) & FANOTIFY_SUPPORTED_FILTER) == 0) {
+		return EINVAL;
+	}
+
+	w = talloc_zero(mem_ctx, struct fanotify_watch_context);
+	if (w == NULL) {
+		return ENOMEM;
+	}
+
+	w->mount_fd = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+	if (w->mount_fd == -1) {
+		ret = errno;
+		TALLOC_FREE(w);
+		return ret;
+	}
+
+	canonical_path = sys_realpath(path);
+	if (canonical_path == NULL) {
+		ret = errno;
+		close(w->mount_fd);
+		TALLOC_FREE(w);
+		return ret;
+	}
+
+	w->in = in;
+	w->callback = callback;
+	w->private_data = private_data;
+	w->filter = *filter;
+	w->subdir_filter = *subdir_filter;
+	w->path = talloc_strdup(w, path);
+	w->canonical_path = talloc_strdup(w, canonical_path);
+	SAFE_FREE(canonical_path);
+	if ((w->path == NULL) || (w->canonical_path == NULL)) {
+		close(w->mount_fd);
+		TALLOC_FREE(w);
+		return ENOMEM;
+	}
+
+	while ((w->path[1] != '\0') &&
+	       (w->path[strlen(w->path) - 1] == '/')) {
+		w->path[strlen(w->path) - 1] = '\0';
+	}
+	while ((w->canonical_path[1] != '\0') &&
+	       (w->canonical_path[strlen(w->canonical_path) - 1] == '/')) {
+		w->canonical_path[strlen(w->canonical_path) - 1] = '\0';
+	}
+
+	ret = fanotify_mark(in->fd,
+			    FAN_MARK_ADD | FAN_MARK_FILESYSTEM,
+			    FANOTIFY_CHANGE_MASK,
+			    AT_FDCWD,
+			    w->canonical_path);
+	if (ret == -1) {
+		ret = errno;
+		close(w->mount_fd);
+		TALLOC_FREE(w);
+		return fanotify_fallback_watch(mem_ctx,
+					       in,
+					       path,
+					       filter,
+					       subdir_filter,
+					       callback,
+					       private_data,
+					       handle_p,
+					       ret);
+	}
+
+	DBG_DEBUG("fanotify filesystem watch for [%s]\n", w->canonical_path);
+
+	DLIST_ADD(in->watches, w);
+	talloc_set_destructor(w, fanotify_watch_destructor);
+	*handle = w;
+
+	/*
+	 * Do not consume either filter. Events generated by smbd are ignored
+	 * above and must continue to use notifyd's internal trigger path.
+	 */
+	return 0;
+}
