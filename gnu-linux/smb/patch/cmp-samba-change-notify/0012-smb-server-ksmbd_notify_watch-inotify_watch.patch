From 9621e38cdc91d0f77b0b62301db8f36d776e7f69 Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Tue, 16 Jun 2026 12:23:20 +0000
Subject: [PATCH 12/23] smb/server: ksmbd_notify_watch --> inotify_watch

TODO: mask |= (IN_MASK_ADD | IN_ONLYDIR)

Signed-off-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/server/notify.c | 36 ++++++++++++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/fs/smb/server/notify.c b/fs/smb/server/notify.c
index d385102b95d5..c50bb4ec0864 100644
--- a/fs/smb/server/notify.c
+++ b/fs/smb/server/notify.c
@@ -139,6 +139,42 @@ static u32 ksmbd_notify_filter_to_mask(u32 filter)
 	return mask;
 }
 
+static int ksmbd_notify_watch(struct ksmbd_notify_ctx *ctx, struct inode *dir)
+{
+	struct fsnotify_group *group;
+	struct ksmbd_notify_mark *mark;
+	int rc = 0;
+
+	group = fsnotify_alloc_group(&ksmbd_notify_fsnotify_ops, 0);
+	if (IS_ERR(group)) {
+		rc = PTR_ERR(group);
+		goto out;
+	}
+
+	mark = kzalloc(sizeof(*mark), GFP_KERNEL);
+	if (!mark) {
+		fsnotify_put_group(group);
+		rc = -ENOMEM;
+		goto out;
+	}
+
+	group->private = ctx;
+	ctx->group = group;
+
+	fsnotify_init_mark(&mark->fsn_mark, group);
+	mark->fsn_mark.mask = ksmbd_notify_filter_to_mask(ctx->completion_filter);
+	ctx->inode_mark = mark;
+
+	rc = fsnotify_add_inode_mark(&mark->fsn_mark, dir, 0);
+	fsnotify_put_mark(&mark->fsn_mark);
+	if (rc)
+		goto out;
+
+	ctx->watching = true;
+out:
+	return rc;
+}
+
 static void smb2_cancel_notify(void **argv)
 {
 	struct ksmbd_notify_ctx *ctx = argv[0];
-- 
