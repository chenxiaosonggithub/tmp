From fa2bd1f5da717ad257f30297f98a327e7f48d60c Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Wed, 17 Jun 2026 01:49:48 +0000
Subject: [PATCH 22/23] smb/server: STATUS_NOTIFY_ENUM_DIR -->
 NT_STATUS_NOTIFY_ENUM_DIR

Signed-off-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/server/notify.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/fs/smb/server/notify.c b/fs/smb/server/notify.c
index 6269d808088c..fe15e7c0db98 100644
--- a/fs/smb/server/notify.c
+++ b/fs/smb/server/notify.c
@@ -512,7 +512,10 @@ int smb2_setup_notify(struct ksmbd_work *work,
 
 		rc = smb2_build_notify_response(work, rsp, ctx);
 		if (rc) {
-			rsp->hdr.Status = STATUS_INSUFFICIENT_RESOURCES;
+			if (rc == -ENOSPC)
+				rsp->hdr.Status = STATUS_NOTIFY_ENUM_DIR;
+			else
+				rsp->hdr.Status = STATUS_INSUFFICIENT_RESOURCES;
 		} else {
 			rsp->hdr.Status = STATUS_SUCCESS;
 		}
