From baa0c8fcc9c9f0f7339b61c30a5fc0a595e99ea3 Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Wed, 17 Jun 2026 01:59:06 +0000
Subject: [PATCH 23/23] smb/server: ksmbd_conn_cancel_async_requests

Signed-off-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/server/connection.c | 18 ++++++++++++++++++
 fs/smb/server/connection.h |  1 +
 fs/smb/server/notify.c     |  2 ++
 3 files changed, 21 insertions(+)

diff --git a/fs/smb/server/connection.c b/fs/smb/server/connection.c
index 9e8fdb39e5a2..4779b4c22cf2 100644
--- a/fs/smb/server/connection.c
+++ b/fs/smb/server/connection.c
@@ -291,6 +291,22 @@ void ksmbd_conn_try_dequeue_request(struct ksmbd_work *work)
 	wake_up_all(&conn->req_running_q);
 }
 
+void ksmbd_conn_cancel_async_requests(struct ksmbd_conn *conn)
+{
+	struct ksmbd_work *iter;
+
+	spin_lock(&conn->request_lock);
+	list_for_each_entry(iter, &conn->async_requests,
+			    async_request_entry) {
+		if (iter->state != KSMBD_WORK_ACTIVE)
+			continue;
+		iter->state = KSMBD_WORK_CLOSED;
+		if (iter->cancel_fn)
+			iter->cancel_fn(iter->cancel_argv);
+	}
+	spin_unlock(&conn->request_lock);
+}
+
 void ksmbd_conn_lock(struct ksmbd_conn *conn)
 {
 	mutex_lock(&conn->srv_mutex);
@@ -564,6 +580,7 @@ int ksmbd_conn_handler_loop(void *p)
 	}
 
 	ksmbd_conn_set_releasing(conn);
+	ksmbd_conn_cancel_async_requests(conn);
 	/* Wait till all reference dropped to the Server object*/
 	ksmbd_debug(CONN, "Wait for all pending requests(%d)\n", atomic_read(&conn->r_count));
 	wait_event(conn->r_count_q, atomic_read(&conn->r_count) == 0);
@@ -657,6 +674,7 @@ static void stop_sessions(void)
 		 */
 		if (READ_ONCE(conn->status) != KSMBD_SESS_RELEASING)
 			ksmbd_conn_set_exiting(conn);
+		ksmbd_conn_cancel_async_requests(conn);
 		target = conn;
 		break;
 	}
diff --git a/fs/smb/server/connection.h b/fs/smb/server/connection.h
index ec75633b7da0..8047181a15d2 100644
--- a/fs/smb/server/connection.h
+++ b/fs/smb/server/connection.h
@@ -185,6 +185,7 @@ int ksmbd_conn_rdma_write(struct ksmbd_conn *conn,
 			  unsigned int desc_len);
 void ksmbd_conn_enqueue_request(struct ksmbd_work *work);
 void ksmbd_conn_try_dequeue_request(struct ksmbd_work *work);
+void ksmbd_conn_cancel_async_requests(struct ksmbd_conn *conn);
 void ksmbd_conn_init_server_callbacks(struct ksmbd_conn_ops *ops);
 int ksmbd_conn_handler_loop(void *p);
 int ksmbd_conn_transport_init(void);
diff --git a/fs/smb/server/notify.c b/fs/smb/server/notify.c
index fe15e7c0db98..1b57344e540f 100644
--- a/fs/smb/server/notify.c
+++ b/fs/smb/server/notify.c
@@ -499,6 +499,8 @@ int smb2_setup_notify(struct ksmbd_work *work,
 		smb2_send_interim_resp(work, STATUS_CANCELLED);
 		work->send_no_response = 1;
 		rc = -ECANCELED;
+	} else if (work->state == KSMBD_WORK_CLOSED) {
+		work->send_no_response = 1;
 	} else if (ctx->events_ready) {
 		unsigned long flags;
 
