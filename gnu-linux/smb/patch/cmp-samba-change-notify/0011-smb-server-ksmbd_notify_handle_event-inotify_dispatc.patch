Date: Tue, 16 Jun 2026 12:19:28 +0000
Subject: [PATCH 11/23] smb/server: ksmbd_notify_handle_event -->
 inotify_dispatch

Signed-off-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/server/notify.c | 45 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/fs/smb/server/notify.c b/fs/smb/server/notify.c
index 020179f92ef9..d385102b95d5 100644
--- a/fs/smb/server/notify.c
+++ b/fs/smb/server/notify.c
@@ -81,6 +81,51 @@ static bool ksmbd_notify_filter_match(u32 filter, u32 mask, u32 mark_mask)
 	return ((filter & FILE_NOTIFY_CHANGE_FILE_NAME) != 0);
 }
 
+static int ksmbd_notify_handle_event(struct fsnotify_group *group, u32 mask,
+				     const void *data, int data_type,
+				     struct inode *dir,
+				     const struct qstr *file_name, u32 cookie,
+				     struct fsnotify_iter_info *iter_info)
+{
+	struct ksmbd_notify_ctx *ctx = group->private;
+	struct ksmbd_notify_mark *imark;
+	u32 event_mask = mask & ALL_FSNOTIFY_EVENTS;
+	u32 action;
+	unsigned long flags;
+	int ret = 0;
+
+	if (!ctx || !ctx->watching)
+		return 0;
+
+	imark = ctx->inode_mark;
+	if (!imark || (event_mask & imark->fsn_mark.mask) == 0)
+		return 0;
+
+	if ((event_mask & (FS_ATTRIB | FS_MODIFY | FS_CREATE | FS_DELETE |
+			   FS_MOVED_FROM | FS_MOVED_TO)) == 0)
+		return 0;
+
+	spin_lock_irqsave(&ctx->lock, flags);
+
+	if (event_mask & FS_MOVED_TO) {
+		action = FILE_ACTION_ADDED;
+	} else if (event_mask & FS_CREATE) {
+		action = FILE_ACTION_ADDED;
+	} else if (event_mask & FS_DELETE) {
+		action = FILE_ACTION_REMOVED;
+	} else {
+		action = FILE_ACTION_MODIFIED;
+	}
+
+	if (ksmbd_notify_filter_match(ctx->completion_filter, mask,
+				      imark->fsn_mark.mask))
+		ret = ksmbd_notify_queue_event_under_lock(ctx, action,
+							  file_name);
+
+	spin_unlock_irqrestore(&ctx->lock, flags);
+	return ret;
+}
+
 static u32 ksmbd_notify_filter_to_mask(u32 filter)
 {
 	size_t i;
