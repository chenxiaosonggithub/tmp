From 68d91650ba9897d5b26bd88a51da68e41d631d09 Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Wed, 17 Jun 2026 01:21:37 +0000
Subject: [PATCH 18/23] smb/server: ksmbd_notify_trigger_orphaned_moved_from
 --> trigger_orphaned_moved_from

Signed-off-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/server/notify.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/fs/smb/server/notify.c b/fs/smb/server/notify.c
index 08fad9729263..7b5a044a6b3d 100644
--- a/fs/smb/server/notify.c
+++ b/fs/smb/server/notify.c
@@ -124,6 +124,24 @@ static bool ksmbd_notify_filter_match(u32 filter, u32 mask, u32 mark_mask)
 	return ((filter & FILE_NOTIFY_CHANGE_FILE_NAME) != 0);
 }
 
+static void ksmbd_notify_trigger_orphaned_moved_from(struct ksmbd_notify_ctx *ctx)
+{
+	struct ksmbd_notify_moved_from *from = ctx->moved_from;
+	struct qstr name;
+
+	if (!from)
+		return;
+
+	name = QSTR_LEN(from->name, from->namelen);
+	if (ksmbd_notify_filter_match(ctx->completion_filter, from->mask,
+				      ctx->inode_mark->fsn_mark.mask))
+		ksmbd_notify_queue_event_under_lock(ctx, FILE_ACTION_REMOVED,
+						    &name);
+
+	kfree(from);
+	ctx->moved_from = NULL;
+}
+
 static void ksmbd_notify_save_moved_from(struct ksmbd_notify_ctx *ctx, u32 mask,
 					 u32 cookie, const struct qstr *file_name)
 {
