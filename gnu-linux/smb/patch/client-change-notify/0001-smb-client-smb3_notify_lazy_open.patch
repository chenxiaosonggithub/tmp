From 37c9400d0f91d1b24778b916b280f0a7a632d2dc Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Thu, 18 Jun 2026 10:44:01 +0800
Subject: [PATCH] smb/client: smb3_notify_lazy_open

Signed-off-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/client/smb2ops.c | 143 +++++++++++++++++++++++++++++-----------
 1 file changed, 104 insertions(+), 39 deletions(-)

diff --git a/fs/smb/client/smb2ops.c b/fs/smb/client/smb2ops.c
index a8f8feeeccb5..07eff40630c4 100644
--- a/fs/smb/client/smb2ops.c
+++ b/fs/smb/client/smb2ops.c
@@ -2367,72 +2367,140 @@ smb3_enum_snapshots(const unsigned int xid, struct cifs_tcon *tcon,
 
 
 static int
-smb3_notify(const unsigned int xid, struct file *pfile,
-	    void __user *ioc_buf, bool return_changes)
+smb3_notify_lazy_open(const unsigned int xid, struct file *pfile)
 {
-	struct smb3_notify_info notify;
-	struct smb3_notify_info __user *pnotify_buf;
-	struct dentry *dentry = pfile->f_path.dentry;
 	struct inode *inode = file_inode(pfile);
 	struct cifs_sb_info *cifs_sb = CIFS_SB(inode->i_sb);
-	struct cifs_open_parms oparms;
-	struct cifs_fid fid;
+	struct cifsFileInfo *cfile, *existing;
 	struct cifs_tcon *tcon;
-	const unsigned char *path;
-	char *returned_ioctl_info = NULL;
-	void *page = alloc_dentry_path();
-	__le16 *utf16_path = NULL;
+	struct tcon_link *tlink;
+	struct cifs_open_parms oparms;
+	struct cifs_fid fid = {};
+	const char *path;
+	void *page;
+	__le16 *utf16_path;
 	u8 oplock = SMB2_OPLOCK_LEVEL_NONE;
-	int rc = 0;
-	__u32 ret_len = 0;
+	int rc;
+
+	spin_lock(&inode->i_lock);
+	existing = pfile->private_data;
+	if (existing && !existing->invalidHandle) {
+		spin_unlock(&inode->i_lock);
+		return 0;
+	}
+	if (existing && existing->invalidHandle) {
+		spin_unlock(&inode->i_lock);
+		return -EBADF;
+	}
+	spin_unlock(&inode->i_lock);
 
-	path = build_path_from_dentry(dentry, page);
+	tlink = cifs_sb_tlink(cifs_sb);
+	if (IS_ERR(tlink))
+		return PTR_ERR(tlink);
+	tcon = tlink_tcon(tlink);
+
+	page = alloc_dentry_path();
+	path = build_path_from_dentry(pfile->f_path.dentry, page);
 	if (IS_ERR(path)) {
 		rc = PTR_ERR(path);
-		goto notify_exit;
+		goto out_tlink;
 	}
 
 	utf16_path = cifs_convert_path_to_utf16(path, cifs_sb);
-	if (utf16_path == NULL) {
+	if (!utf16_path) {
 		rc = -ENOMEM;
-		goto notify_exit;
+		goto out_page;
 	}
 
-	if (return_changes) {
-		if (copy_from_user(&notify, ioc_buf, sizeof(struct smb3_notify_info))) {
-			rc = -EFAULT;
-			goto notify_exit;
-		}
-	} else {
-		if (copy_from_user(&notify, ioc_buf, sizeof(struct smb3_notify))) {
-			rc = -EFAULT;
-			goto notify_exit;
-		}
-		notify.data_len = 0;
+	cfile = kzalloc_obj(struct cifsFileInfo);
+	if (!cfile) {
+		rc = -ENOMEM;
+		goto out_utf16;
 	}
+	spin_lock_init(&cfile->file_info_lock);
+	cfile->tlink = cifs_get_tlink(tlink);
 
-	tcon = cifs_sb_master_tcon(cifs_sb);
 	oparms = (struct cifs_open_parms) {
 		.tcon = tcon,
 		.path = path,
 		.desired_access = FILE_READ_ATTRIBUTES | FILE_READ_DATA,
 		.disposition = FILE_OPEN,
-		.create_options = cifs_create_options(cifs_sb, 0),
+		.create_options = cifs_create_options(cifs_sb, CREATE_NOT_FILE),
 		.fid = &fid,
 	};
 
 	rc = SMB2_open(xid, &oparms, utf16_path, &oplock, NULL, NULL, NULL,
 		       NULL);
-	if (rc)
-		goto notify_exit;
+	if (rc) {
+		cifs_put_tlink(cfile->tlink);
+		kfree(cfile);
+		goto out_utf16;
+	}
+
+	cfile->fid = fid;
+	cfile->invalidHandle = false;
+
+	spin_lock(&inode->i_lock);
+	existing = pfile->private_data;
+	if (existing) {
+		spin_unlock(&inode->i_lock);
+		SMB2_close(xid, tcon, fid.persistent_fid, fid.volatile_fid);
+		cifs_put_tlink(cfile->tlink);
+		kfree(cfile);
+		if (!existing->invalidHandle)
+			return 0;
+		return -EBADF;
+	}
+	pfile->private_data = cfile;
+	spin_unlock(&inode->i_lock);
+
+	rc = 0;
+
+out_utf16:
+	kfree(utf16_path);
+out_page:
+	free_dentry_path(page);
+out_tlink:
+	cifs_put_tlink(tlink);
+	return rc;
+}
+
+static int
+smb3_notify(const unsigned int xid, struct file *pfile,
+	    void __user *ioc_buf, bool return_changes)
+{
+	struct smb3_notify_info notify;
+	struct smb3_notify_info __user *pnotify_buf;
+	struct cifsFileInfo *cfile = pfile->private_data;
+	struct cifs_tcon *tcon;
+	char *returned_ioctl_info = NULL;
+	int rc = 0;
+	__u32 ret_len = 0;
 
-	rc = SMB2_change_notify(xid, tcon, fid.persistent_fid, fid.volatile_fid,
+	if (!cfile || cfile->invalidHandle) {
+		rc = smb3_notify_lazy_open(xid, pfile);
+		if (rc)
+			return rc;
+		cfile = pfile->private_data;
+	}
+
+	if (return_changes) {
+		if (copy_from_user(&notify, ioc_buf, sizeof(struct smb3_notify_info)))
+			return -EFAULT;
+	} else {
+		if (copy_from_user(&notify, ioc_buf, sizeof(struct smb3_notify)))
+			return -EFAULT;
+		notify.data_len = 0;
+	}
+
+	tcon = tlink_tcon(cfile->tlink);
+
+	rc = SMB2_change_notify(xid, tcon, cfile->fid.persistent_fid,
+				cfile->fid.volatile_fid,
 				notify.watch_tree, notify.completion_filter,
 				notify.data_len, &returned_ioctl_info, &ret_len);
 
-	SMB2_close(xid, tcon, fid.persistent_fid, fid.volatile_fid);
-
-	cifs_dbg(FYI, "change notify for path %s rc %d\n", path, rc);
+	cifs_dbg(FYI, "change notify rc %d\n", rc);
 	if (return_changes && (ret_len > 0) && (notify.data_len > 0)) {
 		if (ret_len > notify.data_len)
 			ret_len = notify.data_len;
@@ -2443,9 +2511,6 @@ smb3_notify(const unsigned int xid, struct file *pfile,
 			rc = -EFAULT;
 	}
 	kfree(returned_ioctl_info);
-notify_exit:
-	free_dentry_path(page);
-	kfree(utf16_path);
 	return rc;
 }
 
-- 
2.54.0

