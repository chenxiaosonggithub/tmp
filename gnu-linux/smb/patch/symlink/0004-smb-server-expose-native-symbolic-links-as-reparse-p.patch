+int ksmbd_vfs_get_symlink(const struct path *path, char **target)
+{
+	struct dentry *dentry = path->dentry;
+	struct inode *inode = d_inode(dentry);
+	DEFINE_DELAYED_CALL(done);
+	const char *link;
+	ssize_t len;
+	int err = 0;
+
+	*target = NULL;
+	if (d_is_symlink(dentry)) {
+		/* Magic links require an active name lookup and have no body. */
+		if (inode->i_op->readlink || !inode->i_op->get_link)
+			return -EOPNOTSUPP;
+		link = vfs_get_link(dentry, &done);
+		if (IS_ERR_OR_NULL(link)) {
+			err = link ? PTR_ERR(link) : -EIO;
+		} else {
+			len = strnlen(link, PATH_MAX);
+			if (!len || len == PATH_MAX)
+				err = -EINVAL;
+			else {
+				*target = kmemdup_nul(link, len, KSMBD_DEFAULT_GFP);
+				if (!*target)
+					err = -ENOMEM;
+			}
+		}
+		do_delayed_call(&done);
+		return err;
+	}
+	return -ENODATA;
+}
