diff --git a/fs/smb/server/reparse.c b/fs/smb/server/reparse.c
index 6270dd1cfee3..4edcb85b0c76 100644
--- a/fs/smb/server/reparse.c
+++ b/fs/smb/server/reparse.c
@@ -15,6 +15,65 @@
 #include "../common/smb2status.h"
 #include "../common/smbfsctl.h"
 
+#define KSMBD_SYMLINK_ERROR_TAG	0x4c4d5953
+
+struct ksmbd_symlink_error {
+	__le32 SymLinkLength;
+	__le32 SymLinkErrorTag;
+	__le32 ReparseTag;
+	__le16 ReparseDataLength;
+	__le16 UnparsedPathLength;
+	__le16 SubstituteNameOffset;
+	__le16 SubstituteNameLength;
+	__le16 PrintNameOffset;
+	__le16 PrintNameLength;
+	__le32 Flags;
+	u8 PathBuffer[];
+} __packed;
+
+struct ksmbd_error_context {
+	__le32 ErrorDataLength;
+	__le32 ErrorId;
+	u8 ErrorContextData[];
+} __packed;
+
+static int symlink_to_utf16(__le16 *dst, const char *src, size_t len,
+			    const struct nls_table *nls)
+{
+	int consumed, count = 0;
+	wchar_t wc;
+
+	if (!strcmp(nls->charset, "utf8"))
+		return utf8s_to_utf16s((const u8 *)src, len, UTF16_LITTLE_ENDIAN,
+				      (wchar_t *)dst, len);
+
+	while (len) {
+		consumed = nls->char2uni(src, len, &wc);
+		if (consumed <= 0 || consumed > len || !wc)
+			return -EILSEQ;
+		put_unaligned_le16(wc, &dst[count++]);
+		src += consumed;
+		len -= consumed;
+	}
+	return count;
+}
+
+int ksmbd_symlink_suffix_len(struct ksmbd_work *work, const char *suffix)
+{
+	size_t len = strnlen(suffix, PATH_MAX);
+	__le16 *encoded;
+	int ret;
+
+	if (len == PATH_MAX)
+		return -ENAMETOOLONG;
+	encoded = kmalloc_array(len + 1, sizeof(*encoded), KSMBD_DEFAULT_GFP);
+	if (!encoded)
+		return -ENOMEM;
+	ret = symlink_to_utf16(encoded, suffix, len, work->conn->local_nls);
+	kfree(encoded);
+	return ret < 0 ? ret : ret * sizeof(__le16);
+}
+
 static bool symlink_utf16_valid(const u8 *src, unsigned int len)
 {
 	u16 c;
@@ -142,3 +201,115 @@ int ksmbd_symlink_parse(struct ksmbd_work *work, const void *buf,
 	return ret;
 }
 EXPORT_SYMBOL_IF_KUNIT(ksmbd_symlink_parse);
+
+/* The caller must hold path and impersonate the requesting SMB user. */
+int ksmbd_symlink_read(struct ksmbd_work *work, const struct path *path,
+		       bool posix, struct reparse_symlink_data_buffer **out)
+{
+	struct reparse_symlink_data_buffer *buf = NULL;
+	char *target;
+	size_t len;
+	int count, ret, i;
+
+	*out = NULL;
+	ret = ksmbd_vfs_get_symlink(path, &target);
+	if (ret < 0)
+		return ret;
+	len = strnlen(target, PATH_MAX);
+	if (!len || len >= PATH_MAX) {
+		ret = len ? -ENAMETOOLONG : -EINVAL;
+		goto out;
+	}
+
+	/* An absolute Unix target has no unambiguous Windows namespace. */
+	if (!posix && target[0] == '/') {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+
+	buf = kzalloc(struct_size(buf, PathBuffer, 2 * (len + 1)),
+		      KSMBD_DEFAULT_GFP);
+	if (!buf) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	count = symlink_to_utf16((__le16 *)buf->PathBuffer, target, len,
+				 work->conn->local_nls);
+	if (count < 0) {
+		ret = count;
+		goto out;
+	}
+	if (!posix) {
+		for (i = 0; i < count; i++) {
+			if (get_unaligned_le16(buf->PathBuffer + 2 * i) == '/')
+				put_unaligned_le16('\\', buf->PathBuffer + 2 * i);
+		}
+	}
+
+	len = count * sizeof(__le16);
+	buf->ReparseTag = cpu_to_le32(IO_REPARSE_TAG_SYMLINK);
+	buf->ReparseDataLength = cpu_to_le16(12 + len);
+	buf->SubstituteNameLength = cpu_to_le16(len);
+	buf->PrintNameLength = cpu_to_le16(len);
+	buf->Flags = target[0] == '/' ? 0 : cpu_to_le32(SYMLINK_FLAG_RELATIVE);
+	ret = sizeof(*buf) + len;
+	*out = buf;
+	buf = NULL;
+out:
+	kfree(buf);
+	kfree(target);
+	return ret;
+}
+
+int smb2_symlink_error_rsp(struct ksmbd_work *work, const struct path *path,
+			   bool posix, u16 unparsed_len)
+{
+	struct reparse_symlink_data_buffer *reparse;
+	struct ksmbd_symlink_error *symlink;
+	struct ksmbd_error_context *context;
+	struct smb2_err_rsp *rsp;
+	size_t offset, context_len = 0, data_len, total_len;
+	int ret, reparse_len;
+
+	reparse_len = ksmbd_symlink_read(work, path, posix, &reparse);
+	if (reparse_len < 0)
+		return reparse_len;
+
+	rsp = work->next_smb2_rcv_hdr_off ? ksmbd_resp_buf_next(work) :
+		smb_get_msg(work->response_buf);
+	offset = (char *)rsp - (char *)work->response_buf;
+	if (work->conn->dialect == SMB311_PROT_ID)
+		context_len = sizeof(*context);
+	data_len = sizeof(*symlink) + reparse_len - sizeof(*reparse);
+	total_len = sizeof(*rsp) + context_len + data_len;
+	if (offset > work->response_sz ||
+	    total_len > work->response_sz - offset) {
+		ret = -ENOSPC;
+		goto out;
+	}
+
+	rsp->StructureSize = SMB2_ERROR_STRUCTURE_SIZE2_LE;
+	rsp->ErrorContextCount = context_len ? 1 : 0;
+	rsp->Reserved = 0;
+	rsp->ByteCount = cpu_to_le32(context_len + data_len);
+	if (context_len) {
+		context = (struct ksmbd_error_context *)rsp->ErrorData;
+		context->ErrorDataLength = cpu_to_le32(data_len);
+		context->ErrorId = 0;
+		symlink = (struct ksmbd_symlink_error *)context->ErrorContextData;
+	} else {
+		symlink = (struct ksmbd_symlink_error *)rsp->ErrorData;
+	}
+	symlink->SymLinkLength = cpu_to_le32(data_len - sizeof(__le32));
+	symlink->SymLinkErrorTag = cpu_to_le32(KSMBD_SYMLINK_ERROR_TAG);
+	/* The native reparse header differs only in its Reserved field. */
+	memcpy(&symlink->ReparseTag, reparse, reparse_len);
+	symlink->UnparsedPathLength = cpu_to_le16(unparsed_len);
+
+	ret = ksmbd_iov_pin_rsp(work, rsp, total_len);
+	if (!ret)
+		rsp->hdr.Status = STATUS_STOPPED_ON_SYMLINK;
+out:
+	kfree(reparse);
+	return ret;
+}
