+/**
+ * ksmbd_vfs_lookup_symlink() - locate the first symlink without following it
+ * @work: request with the caller's filesystem credentials installed
+ * @name: path relative to the share, updated with matching filename case
+ * @path: referenced path of the first symlink or final ordinary object
+ * @unparsed_offset: byte offset in @name of the remaining path, including '/'
+ *
+ * Every prefix lookup stays beneath the share and refuses to follow native
+ * symlinks. A concurrent rename can make a later lookup fail, but cannot
+ * redirect it through a native symlink. Copy back corrected filename case
+ * even when the last component does not exist, so CREATE uses the same parent.
+ *
+ * Return: 0 for a symlink, 1 for an ordinary object, or a lookup error.
+ */
+int ksmbd_vfs_lookup_symlink(struct ksmbd_work *work, char *name,
+			     struct path *path, size_t *unparsed_offset)
+{
+	char *buf, *component, *next;
+	size_t len;
+	int err = -ENOENT;
+
+	len = strnlen(name, PATH_MAX);
+	if (len == PATH_MAX)
+		return -ENAMETOOLONG;
+	if (name[0] == '/')
+		return -EINVAL;
+
+	buf = kmemdup_nul(name, len, KSMBD_DEFAULT_GFP);
+	if (!buf)
+		return -ENOMEM;
+	if (!len) {
+		err = ksmbd_vfs_kern_path(work, buf, LOOKUP_NO_SYMLINKS,
+					 path, true);
+		if (!err) {
+			*unparsed_offset = 0;
+			err = 1;
+		}
+		goto out;
+	}
+
+	component = buf;
+	while (*component) {
+		char *target;
+		char saved;
+
+		next = strchrnul(component, '/');
+		saved = *next;
+		*next = '\0';
+		err = ksmbd_vfs_kern_path(work, buf,
+					 LOOKUP_NO_SYMLINKS | LOOKUP_BENEATH,
+					 path, true);
+		*next = saved;
+		if (err)
+			break;
+		if (d_is_symlink(path->dentry)) {
+			*unparsed_offset = next - buf;
+			break;
+		}
+		err = ksmbd_vfs_get_symlink(path, &target);
+		if (!err) {
+			kfree(target);
+			*unparsed_offset = next - buf;
+			break;
+		}
+		if (err != -ENODATA) {
+			path_put(path);
+			break;
+		}
+		component = next;
+		while (*component == '/')
+			component++;
+		if (!*component && (!saved || d_can_lookup(path->dentry))) {
+			*unparsed_offset = len;
+			err = 1;
+			break;
+		}
+		err = d_can_lookup(path->dentry) ? -ENOENT : -ENOTDIR;
+		path_put(path);
+		if (err == -ENOTDIR)
+			break;
+	}
+
+out:
+	memcpy(name, buf, len + 1);
+	kfree(buf);
+	return err;
+}
