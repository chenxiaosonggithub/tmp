diff --git a/fs/smb/server/tests/reparse_kunit.c b/fs/smb/server/tests/reparse_kunit.c
new file mode 100644
index 000000000000..8b674e6f9880
--- /dev/null
+++ b/fs/smb/server/tests/reparse_kunit.c
@@ -0,0 +1,215 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <kunit/test.h>
+#include <linux/nls.h>
+#include <linux/unaligned.h>
+
+#include "../connection.h"
+#include "../reparse.h"
+#include "../../common/smbfsctl.h"
+
+struct reparse_test_ctx {
+	struct ksmbd_work work;
+	struct ksmbd_conn conn;
+};
+
+static int reparse_test_init(struct kunit *test)
+{
+	struct reparse_test_ctx *ctx;
+
+	ctx = kunit_kzalloc(test, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->conn.local_nls = load_nls("utf8");
+	if (!ctx->conn.local_nls)
+		return -EINVAL;
+	ctx->work.conn = &ctx->conn;
+	test->priv = ctx;
+	return 0;
+}
+
+static void reparse_test_exit(struct kunit *test)
+{
+	struct reparse_test_ctx *ctx = test->priv;
+
+	unload_nls(ctx->conn.local_nls);
+}
+
+static struct reparse_symlink_data_buffer *make_reparse(struct kunit *test,
+						       const u16 *target,
+						       unsigned int count,
+						       u32 flags)
+{
+	struct reparse_symlink_data_buffer *buf;
+	unsigned int i;
+
+	buf = kunit_kzalloc(test, struct_size(buf, PathBuffer, 2 * count),
+			   GFP_KERNEL);
+	if (!buf)
+		return NULL;
+	buf->ReparseTag = cpu_to_le32(IO_REPARSE_TAG_SYMLINK);
+	buf->ReparseDataLength = cpu_to_le16(12 + 2 * count);
+	buf->SubstituteNameLength = cpu_to_le16(2 * count);
+	buf->PrintNameLength = cpu_to_le16(2 * count);
+	buf->Flags = cpu_to_le32(flags);
+	for (i = 0; i < count; i++)
+		put_unaligned_le16(target[i], buf->PathBuffer + 2 * i);
+	return buf;
+}
+
+static void ksmbd_symlink_parse_targets(struct kunit *test)
+{
+	static const struct {
+		u16 wire[10];
+		u8 count;
+		bool posix;
+		u32 flags;
+		int error;
+		const char *expected;
+	} cases[] = {
+		{ { 'f', 'i', 'l', 'e' }, 4, false, 1, 0, "file" },
+		{ { 'd', '\\', 'f' }, 3, false, 1, 0, "d/f" },
+		{ { 'd', '\\', 'f' }, 3, true, 1, 0, "d\\f" },
+		{ { '/', 'f' }, 2, true, 0, 0, "/f" },
+		{ { '/', 'f' }, 2, true, 1, -EINVAL, NULL },
+		{ { 'f' }, 1, true, 0, -EINVAL, NULL },
+		{ { '/', 'f' }, 2, false, 0, -EOPNOTSUPP, NULL },
+		{ { '\\', 'f' }, 2, false, 1, -EINVAL, NULL },
+		{ { 0x6570, 0x636e, 0xd83d, 0xde00 }, 4, true, 1, 0,
+		  "\xe6\x95\xb0\xe6\x8d\xae\xf0\x9f\x98\x80" },
+	};
+	struct reparse_test_ctx *ctx = test->priv;
+	struct reparse_symlink_data_buffer *buf;
+	char *target;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(cases); i++) {
+		buf = make_reparse(test, cases[i].wire, cases[i].count,
+				   cases[i].flags);
+		KUNIT_ASSERT_NOT_NULL(test, buf);
+		ret = ksmbd_symlink_parse(&ctx->work, buf,
+					 sizeof(*buf) + 2 * cases[i].count,
+					 cases[i].posix, &target);
+		KUNIT_EXPECT_EQ_MSG(test, ret, cases[i].error, "case %d", i);
+		if (cases[i].error)
+			KUNIT_EXPECT_NULL(test, target);
+		else if (target)
+			KUNIT_EXPECT_STREQ(test, target, cases[i].expected);
+		else
+			KUNIT_FAIL(test, "case %d returned no target", i);
+		kfree(target);
+	}
+}
+
+static void ksmbd_symlink_parse_malformed(struct kunit *test)
+{
+	const u16 name[] = { 'f', 'i', 'l', 'e' };
+	struct reparse_test_ctx *ctx = test->priv;
+	struct reparse_symlink_data_buffer *buf;
+	unsigned int len;
+	char *target;
+	int i, ret;
+
+	for (i = 0; i < 13; i++) {
+		buf = make_reparse(test, name, ARRAY_SIZE(name), 1);
+		KUNIT_ASSERT_NOT_NULL(test, buf);
+		len = sizeof(*buf) + sizeof(name);
+		switch (i) {
+		case 0:
+			len = 7;
+			break;
+		case 1:
+			buf->ReparseDataLength = cpu_to_le16(19);
+			break;
+		case 2:
+			buf->SubstituteNameOffset = cpu_to_le16(1);
+			break;
+		case 3:
+			buf->SubstituteNameOffset = cpu_to_le16(10);
+			break;
+		case 4:
+			buf->SubstituteNameLength = cpu_to_le16(7);
+			break;
+		case 5:
+			buf->SubstituteNameLength = 0;
+			break;
+		case 6:
+			put_unaligned_le16(0, buf->PathBuffer + 2);
+			break;
+		case 7:
+			put_unaligned_le16(0xd800, buf->PathBuffer + 2);
+			break;
+		case 8:
+			put_unaligned_le16(0xdc00, buf->PathBuffer + 2);
+			break;
+		case 9:
+			buf->Flags = cpu_to_le32(2);
+			break;
+		case 10:
+			buf->PrintNameLength = cpu_to_le16(7);
+			break;
+		case 11:
+			buf->PrintNameOffset = cpu_to_le16(10);
+			break;
+		case 12:
+			buf->PrintNameOffset = cpu_to_le16(1);
+			break;
+		}
+		ret = ksmbd_symlink_parse(&ctx->work, buf, len, true, &target);
+		KUNIT_EXPECT_EQ_MSG(test, ret, -EINVAL, "case %d", i);
+		KUNIT_EXPECT_NULL(test, target);
+		kfree(target);
+	}
+}
+
+static void ksmbd_symlink_parse_length_limit(struct kunit *test)
+{
+	struct reparse_test_ctx *ctx = test->priv;
+	struct reparse_symlink_data_buffer *buf;
+	u16 *name;
+	char *target;
+	int i, ret;
+
+	name = kunit_kmalloc_array(test, PATH_MAX, sizeof(*name), GFP_KERNEL);
+	KUNIT_ASSERT_NOT_NULL(test, name);
+	for (i = 0; i < PATH_MAX; i++)
+		name[i] = 'a';
+	buf = make_reparse(test, name, PATH_MAX - 1, 1);
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	ret = ksmbd_symlink_parse(&ctx->work, buf,
+				 sizeof(*buf) + 2 * (PATH_MAX - 1), true, &target);
+	KUNIT_EXPECT_EQ(test, ret, 0);
+	if (target)
+		KUNIT_EXPECT_EQ(test, strlen(target), (size_t)PATH_MAX - 1);
+	else
+		KUNIT_FAIL(test, "maximum valid target was not returned");
+	kfree(target);
+
+	buf = make_reparse(test, name, PATH_MAX, 1);
+	KUNIT_ASSERT_NOT_NULL(test, buf);
+	ret = ksmbd_symlink_parse(&ctx->work, buf,
+				 sizeof(*buf) + 2 * PATH_MAX, true, &target);
+	KUNIT_EXPECT_EQ(test, ret, -ENAMETOOLONG);
+	KUNIT_EXPECT_NULL(test, target);
+	kfree(target);
+}
+
+static struct kunit_case ksmbd_reparse_test_cases[] = {
+	KUNIT_CASE(ksmbd_symlink_parse_targets),
+	KUNIT_CASE(ksmbd_symlink_parse_malformed),
+	KUNIT_CASE(ksmbd_symlink_parse_length_limit),
+	{}
+};
+
+static struct kunit_suite ksmbd_reparse_test_suite = {
+	.name = "ksmbd-reparse",
+	.init = reparse_test_init,
+	.exit = reparse_test_exit,
+	.test_cases = ksmbd_reparse_test_cases,
+};
+
+kunit_test_suite(ksmbd_reparse_test_suite);
+
+MODULE_DESCRIPTION("KUnit tests for ksmbd symbolic link reparse data");
+MODULE_LICENSE("GPL");
+MODULE_IMPORT_NS("EXPORTED_FOR_KUNIT_TESTING");
-- 
