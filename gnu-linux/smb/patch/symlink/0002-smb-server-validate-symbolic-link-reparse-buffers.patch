--- /dev/null
+++ b/fs/smb/server/reparse.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <kunit/visibility.h>
+#include <linux/fs.h>
+#include <linux/limits.h>
+#include <linux/nls.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#include "connection.h"
+#include "ksmbd_work.h"
+#include "reparse.h"
+#include "vfs.h"
+#include "../common/smb2status.h"
+#include "../common/smbfsctl.h"
+
+static bool symlink_utf16_valid(const u8 *src, unsigned int len)
+{
+	u16 c;
+	unsigned int i;
+
+	if (len & 1)
+		return false;
+	for (i = 0; i < len; i += 2) {
+		c = get_unaligned_le16(src + i);
+		if (!c || (c >= 0xdc00 && c <= 0xdfff))
+			return false;
+		if (c < 0xd800 || c > 0xdbff)
+			continue;
+		i += 2;
+		if (i == len)
+			return false;
+		c = get_unaligned_le16(src + i);
+		if (c < 0xdc00 || c > 0xdfff)
+			return false;
+	}
+	return true;
+}
+
+/* The input has already been checked for complete UTF-16 scalar values. */
+static int symlink_from_utf16(const u8 *src, unsigned int len,
+			      const struct nls_table *nls, char **target)
+{
+	char *out;
+	unsigned int i, used = 0;
+	u32 c;
+	int ret;
+	bool utf8 = !strcmp(nls->charset, "utf8");
+
+	out = kmalloc(PATH_MAX, KSMBD_DEFAULT_GFP);
+	if (!out)
+		return -ENOMEM;
+	for (i = 0; i < len; i += 2) {
+		c = get_unaligned_le16(src + i);
+		if (c >= 0xd800 && c <= 0xdbff) {
+			i += 2;
+			c = 0x10000 + ((c - 0xd800) << 10) +
+			    get_unaligned_le16(src + i) - 0xdc00;
+		}
+		if (utf8)
+			ret = utf32_to_utf8(c, (u8 *)out + used,
+					    PATH_MAX - 1 - used);
+		else if (c <= 0xffff)
+			ret = nls->uni2char(c, out + used, PATH_MAX - 1 - used);
+		else
+			ret = -EILSEQ;
+		if (ret <= 0)
+			goto out_free;
+		used += ret;
+	}
+	out[used] = '\0';
+	*target = out;
+	return 0;
+out_free:
+	kfree(out);
+	if (ret == -EOVERFLOW)
+		ret = -ENAMETOOLONG;
+	return ret ? ret : -EILSEQ;
+}
+
+int ksmbd_symlink_parse(struct ksmbd_work *work, const void *buf,
+			unsigned int len, bool posix, char **target)
+{
+	const struct reparse_symlink_data_buffer *reparse = buf;
+	unsigned int data_len, path_len, sub_off, sub_len, print_off, print_len;
+	u32 flags;
+	char *name, *p;
+	int ret;
+
+	*target = NULL;
+	if (len < sizeof(struct reparse_data_buffer) || len > SZ_16K)
+		return -EINVAL;
+	if (le32_to_cpu(reparse->ReparseTag) != IO_REPARSE_TAG_SYMLINK)
+		return -EOPNOTSUPP;
+	data_len = le16_to_cpu(reparse->ReparseDataLength);
+	if (data_len < 12 || data_len != len - sizeof(struct reparse_data_buffer))
+		return -EINVAL;
+	path_len = data_len - 12;
+	sub_off = le16_to_cpu(reparse->SubstituteNameOffset);
+	sub_len = le16_to_cpu(reparse->SubstituteNameLength);
+	print_off = le16_to_cpu(reparse->PrintNameOffset);
+	print_len = le16_to_cpu(reparse->PrintNameLength);
+	flags = le32_to_cpu(reparse->Flags);
+	if (flags & ~SYMLINK_FLAG_RELATIVE || !sub_len ||
+	    (sub_off | print_off) & 1 ||
+	    sub_off > path_len || sub_len > path_len - sub_off ||
+	    print_off > path_len || print_len > path_len - print_off)
+		return -EINVAL;
+	if (!symlink_utf16_valid(reparse->PathBuffer + sub_off, sub_len) ||
+	    !symlink_utf16_valid(reparse->PathBuffer + print_off, print_len))
+		return -EINVAL;
+	ret = symlink_from_utf16(reparse->PathBuffer + sub_off, sub_len,
+				 work->conn->local_nls, &name);
+	if (ret)
+		return ret;
+
+	if (posix) {
+		if ((name[0] == '/') == !!(flags & SYMLINK_FLAG_RELATIVE)) {
+			ret = -EINVAL;
+			goto out_free;
+		}
+	} else {
+		/* NT absolute paths cannot be represented as local Unix links. */
+		if (!(flags & SYMLINK_FLAG_RELATIVE)) {
+			ret = -EOPNOTSUPP;
+			goto out_free;
+		}
+		if (name[0] == '\\' || name[0] == '/') {
+			ret = -EINVAL;
+			goto out_free;
+		}
+		for (p = name; *p; p++) {
+			if (*p == '\\')
+				*p = '/';
+		}
+	}
+	*target = name;
+	return 0;
+out_free:
+	kfree(name);
+	return ret;
+}
+EXPORT_SYMBOL_IF_KUNIT(ksmbd_symlink_parse);
