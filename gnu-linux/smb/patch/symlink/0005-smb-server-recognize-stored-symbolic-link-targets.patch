diff --git a/fs/smb/server/oplock.c b/fs/smb/server/oplock.c
index 9ded27df159f..a49aa4a420ca 100644
--- a/fs/smb/server/oplock.c
+++ b/fs/smb/server/oplock.c
@@ -2569,8 +2569,10 @@ void create_disk_id_rsp_buf(char *cc, __u64 file_id, __u64 vol_id)
  * create_posix_rsp_buf() - create posix extension context
  * @cc:	buffer to create posix on posix response
  * @fp: ksmbd file pointer
+ * @stat: effective file attributes, including stored reparse point metadata
  */
-void create_posix_rsp_buf(char *cc, struct ksmbd_file *fp)
+void create_posix_rsp_buf(char *cc, struct ksmbd_file *fp,
+			  const struct kstat *stat)
 {
 	struct create_posix_rsp *buf;
 	struct inode *inode = file_inode(fp->filp);
@@ -2608,10 +2610,10 @@ void create_posix_rsp_buf(char *cc, struct ksmbd_file *fp)
 	buf->Name[14] = 0xCD;
 	buf->Name[15] = 0x7C;
 
-	buf->nlink = cpu_to_le32(inode->i_nlink);
-	buf->reparse_tag = smb2_get_reparse_tag_special_file(inode->i_mode);
-	buf->mode = cpu_to_le32(inode->i_mode & 07777);
-	switch (inode->i_mode & S_IFMT) {
+	buf->nlink = cpu_to_le32(stat->nlink);
+	buf->reparse_tag = smb2_get_reparse_tag_special_file(stat->mode);
+	buf->mode = cpu_to_le32(stat->mode & 07777);
+	switch (stat->mode & S_IFMT) {
 	case S_IFDIR:
 		buf->mode |= cpu_to_le32(POSIX_TYPE_DIR << POSIX_FILETYPE_SHIFT);
 		break;
