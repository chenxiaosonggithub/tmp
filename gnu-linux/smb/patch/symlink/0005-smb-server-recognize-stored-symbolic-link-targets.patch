 		if (ret) {
 			ksmbd_fd_put(work, fp);
 			goto out;
@@ -12388,7 +12390,6 @@ int smb2_ioctl(struct ksmbd_work *work)
 			ret = -EACCES;
 			goto dup_ext_out;
 		}
-
 		if (ksmbd_vfs_is_reparse_point(fp_in) ||
 		    ksmbd_vfs_is_reparse_point(fp_out)) {
 			ret = -EACCES;
diff --git a/fs/smb/server/vfs.c b/fs/smb/server/vfs.c
index c69cc6ca690d..9d142f7746d3 100644
--- a/fs/smb/server/vfs.c
+++ b/fs/smb/server/vfs.c
@@ -615,6 +615,8 @@ int ksmbd_vfs_getattr(const struct path *path, struct kstat *stat)
 
 	err = vfs_getattr(path, stat, STATX_BASIC_STATS | STATX_BTIME,
 			AT_STATX_SYNC_AS_STAT);
+	if (!err)
+		err = ksmbd_vfs_symlink_stat(path, stat);
 	if (err)
 		pr_err("getattr failed, err %d\n", err);
 	return err;
@@ -626,6 +628,7 @@ int ksmbd_vfs_get_symlink(const struct path *path, char **target)
 	struct inode *inode = d_inode(dentry);
 	DEFINE_DELAYED_CALL(done);
 	const char *link;
+	char *buf;
 	ssize_t len;
 	int err = 0;
 
@@ -650,7 +653,52 @@ int ksmbd_vfs_get_symlink(const struct path *path, char **target)
 		do_delayed_call(&done);
 		return err;
 	}
-	return -ENODATA;
+	if (!S_ISREG(inode->i_mode) && !S_ISDIR(inode->i_mode))
+		return -ENODATA;
+
+	/* Private server metadata must also be visible to attribute-only opens. */
+	len = __vfs_getxattr(dentry, inode, XATTR_NAME_KSMBD_SYMLINK, NULL, 0);
+	if (len == -EOPNOTSUPP)
+		return -ENODATA;
+	if (len < 0)
+		return len;
+	if (!len || len >= PATH_MAX)
+		return -EINVAL;
+
+	buf = kmalloc(PATH_MAX, KSMBD_DEFAULT_GFP);
+	if (!buf)
+		return -ENOMEM;
+	len = __vfs_getxattr(dentry, inode, XATTR_NAME_KSMBD_SYMLINK,
+			     buf, PATH_MAX - 1);
+	if (len < 0)
+		err = len;
+	else if (!len || memchr(buf, '\0', len))
+		err = -EINVAL;
+	if (err) {
+		kfree(buf);
+		return err;
+	}
+	buf[len] = '\0';
+	*target = buf;
+	return 0;
+}
+
+int ksmbd_vfs_symlink_stat(const struct path *path, struct kstat *stat)
+{
+	char *target;
+	int err;
+
+	if (S_ISLNK(stat->mode))
+		return 0;
+	err = ksmbd_vfs_get_symlink(path, &target);
+	if (err == -ENODATA)
+		return 0;
+	if (err)
+		return err;
+	stat->mode = S_IFLNK | 0777;
+	stat->size = strlen(target);
+	kfree(target);
+	return 0;
 }
 
