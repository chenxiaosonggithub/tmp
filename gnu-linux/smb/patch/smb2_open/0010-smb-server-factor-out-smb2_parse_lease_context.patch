From ed16d665f5ad17a4a21f9899d2d3688b440915fd Mon Sep 17 00:00:00 2001
From: ZhangGuoDong <zhangguodong@kylinos.cn>
Date: Wed, 4 Nov 2026 10:48:07 +0800
Subject: [PATCH 10/21] smb/server: factor out smb2_parse_lease_context()

Use smb2_parse_lease_context() to share the lease parsing code.

No functional change.

Signed-off-by: ZhangGuoDong <zhangguodong@kylinos.cn>
Reviewed-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/server/smb2pdu.c | 55 +++++++++++++++++++++++------------------
 1 file changed, 31 insertions(+), 24 deletions(-)

diff --git a/fs/smb/server/smb2pdu.c b/fs/smb/server/smb2pdu.c
index 838159fc4eb1..cf8fde27ad2f 100644
--- a/fs/smb/server/smb2pdu.c
+++ b/fs/smb/server/smb2pdu.c
@@ -4576,6 +4576,33 @@ static char *smb2_get_create_name(struct ksmbd_work *work,
 	return ERR_PTR(rc);
 }
 
+static int smb2_parse_lease_context(struct ksmbd_conn *conn,
+				    struct smb2_create_req *req,
+				    struct smb2_create_contexts *ctx)
+{
+	int rc;
+
+	if (!(server_conf.flags & KSMBD_GLOBAL_FLAG_DURABLE_HANDLE &&
+	      req->CreateContextsOffset) &&
+	    ctx->oplock_level != SMB2_OPLOCK_LEVEL_LEASE)
+		return 0;
+
+	ctx->lease = parse_lease_state(req);
+	if (IS_ERR(ctx->lease)) {
+		rc = PTR_ERR(ctx->lease);
+		ctx->lease = NULL;
+		return rc;
+	}
+	if (ctx->lease && ctx->lease->version == 2 && conn->dialect < SMB30_PROT_ID) {
+		kfree(ctx->lease);
+		ctx->lease = NULL;
+		if (ctx->oplock_level == SMB2_OPLOCK_LEVEL_LEASE)
+			ctx->oplock_level = SMB2_OPLOCK_LEVEL_NONE;
+	}
+
+	return 0;
+}
+
 static int smb2_parse_posix_context(struct ksmbd_work *work,
 				    struct smb2_create_req *req,
 				    struct smb2_create_rsp *rsp,
@@ -4891,20 +4918,12 @@ int smb2_open(struct ksmbd_work *work)
 			goto err_out2;
 	}
 
+	rc = smb2_parse_lease_context(conn, req, &ctx);
+	if (rc)
+		goto err_out2;
+
 	if (server_conf.flags & KSMBD_GLOBAL_FLAG_DURABLE_HANDLE &&
 	    req->CreateContextsOffset) {
-		ctx.lease = parse_lease_state(req);
-		if (IS_ERR(ctx.lease)) {
-			rc = PTR_ERR(ctx.lease);
-			ctx.lease = NULL;
-			goto err_out2;
-		}
-		if (ctx.lease && ctx.lease->version == 2 && conn->dialect < SMB30_PROT_ID) {
-			kfree(ctx.lease);
-			ctx.lease = NULL;
-			if (ctx.oplock_level == SMB2_OPLOCK_LEVEL_LEASE)
-				ctx.oplock_level = SMB2_OPLOCK_LEVEL_NONE;
-		}
 		rc = parse_durable_handle_context(work, req, ctx.lease, &ctx.durable);
 		if (rc) {
 			ksmbd_debug(SMB, "error parsing durable handle context\n");
@@ -4956,18 +4975,6 @@ int smb2_open(struct ksmbd_work *work)
 			goto reconnected_fp;
 		}
 
-	} else if (ctx.oplock_level == SMB2_OPLOCK_LEVEL_LEASE) {
-		ctx.lease = parse_lease_state(req);
-		if (IS_ERR(ctx.lease)) {
-			rc = PTR_ERR(ctx.lease);
-			ctx.lease = NULL;
-			goto err_out2;
-		}
-		if (ctx.lease && ctx.lease->version == 2 && conn->dialect < SMB30_PROT_ID) {
-			kfree(ctx.lease);
-			ctx.lease = NULL;
-			ctx.oplock_level = SMB2_OPLOCK_LEVEL_NONE;
-		}
 	}
 
 	rc = smb2_check_create_request(req, rsp);
-- 
