-	struct create_context *last_context = NULL;
 	int open_flags = 0, may_flags = 0, file_info = 0;
 	int rc = 0;
-	bool durable_rsp = true;
 	int s_type = 0;
 	char *name = NULL;
 	char *stream_name = NULL;
