From dab27639656dfb85ba8cafee080159da87a872ca Mon Sep 17 00:00:00 2001
From: ZhangGuoDong <zhangguodong@kylinos.cn>
Date: Wed, 4 Nov 2026 10:51:39 +0800
Subject: [PATCH 19/21] smb/server: use smb2_add_create_context() for maximal
 access responses

Keep the access query in this path, and let the shared helper handle
context space, length and links. This removes the repeated setup code.

No functional change.

Signed-off-by: ZhangGuoDong <zhangguodong@kylinos.cn>
Reviewed-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/server/smb2pdu.c | 16 +++-------------
 1 file changed, 3 insertions(+), 13 deletions(-)

diff --git a/fs/smb/server/smb2pdu.c b/fs/smb/server/smb2pdu.c
index f3c0c75d27a0..930cc7583d1e 100644
--- a/fs/smb/server/smb2pdu.c
+++ b/fs/smb/server/smb2pdu.c
@@ -5574,23 +5574,13 @@ int smb2_open(struct ksmbd_work *work)
 	opinfo_put(opinfo);
 
 	if (ctx.query_maximal_access) {
-		struct create_context *mxac_ccontext;
-
 		if (ctx.maximal_access == 0)
 			ksmbd_vfs_query_maximal_access(idmap,
 						       path.dentry,
 						       &ctx.maximal_access);
-		mxac_ccontext = (struct create_context *)(rsp->Buffer +
-				le32_to_cpu(rsp->CreateContextsLength));
-		create_mxac_rsp_buf(rsp->Buffer +
-				le32_to_cpu(rsp->CreateContextsLength),
-				le32_to_cpu(ctx.maximal_access));
-		le32_add_cpu(&rsp->CreateContextsLength,
-			     conn->vals->create_mxac_size);
-		if (last_context)
-			last_context->Next =
-				cpu_to_le32((char *)mxac_ccontext - (char *)last_context);
-		last_context = mxac_ccontext;
+		create_mxac_rsp_buf(smb2_add_create_context(rsp, &last_context,
+							  conn->vals->create_mxac_size),
+				    le32_to_cpu(ctx.maximal_access));
 	}
 
 	if (ctx.query_disk_id)
-- 
