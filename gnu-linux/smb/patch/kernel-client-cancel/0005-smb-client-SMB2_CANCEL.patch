diff --git a/fs/smb/client/smb2pdu.c b/fs/smb/client/smb2pdu.c
index be98d8b6258f..d9f8b01ad811 100644
--- a/fs/smb/client/smb2pdu.c
+++ b/fs/smb/client/smb2pdu.c
@@ -4054,11 +4054,82 @@ SMB2_notify_init(const unsigned int xid, struct smb_rqst *rqst,
 	return 0;
 }
 
+// 似乎也可以不用定义这个结构体，在SMB2_cancel()中直接使用struct smb2_hdr
+struct smb2_cancel_req {
+	struct smb2_hdr hdr;
+	__le16 StructureSize;
+	__le16 Reserved;
+} __packed;
+
+/*
+ *  smb2_print_stats()函数中有以下注释，需要把per-session和per tcon的区别搞清楚
+ *  Can't display SMB2_NEGOTIATE, SESSION_SETUP, LOGOFF, CANCEL and ECHO
+ *  totals (requests sent) since those SMBs are per-session not per tcon
+ */
+int SMB2_cancel(const unsigned int xid, struct cifs_ses *ses, __le64 msg_id)
+{
+	int rc;
+	struct smb_rqst rqst;
+	struct smb2_cancel_req *req = NULL;
+	struct TCP_Server_Info *server;
+	struct kvec iov[1];
+	unsigned int total_len;
+	int flags = 0;
+	int resp_buf_type;
+	struct kvec rsp_iov;
+
+	if (!ses || !ses->server)
+		return smb_EIO(smb_eio_trace_null_pointers);
+	server = ses->server;
+
+	rc = smb2_plain_req_init(SMB2_CANCEL, NULL, server,
+				 (void **) &req, &total_len);
+	if (rc)
+		goto out;
+
+	 /* since no tcon, smb2_init can not do this, so do here */
+	req->hdr.SessionId = cpu_to_le64(ses->Suid);
+
+	// 确认这些flag有哪些不需要设置可以去掉
+	if (ses->session_flags & SMB2_SESSION_FLAG_ENCRYPT_DATA)
+		flags |= CIFS_TRANSFORM_REQ;
+	else if (server->sign)
+		req->hdr.Flags |= SMB2_FLAGS_SIGNED;
+	flags |= CIFS_NO_RSP_BUF;
+	req->hdr.Flags |= SMB2_FLAGS_ASYNC_COMMAND;
+
+	req->hdr.MessageId = msg_id;
+	req->hdr.Id.AsyncId = cancel_test_async_id;
+
+	iov[0].iov_base = (char *)req;
+	iov[0].iov_len = total_len;
+
+	memset(&rqst, 0, sizeof(struct smb_rqst));
+	rqst.rq_iov = iov;
+	rqst.rq_nvec = 1;
+
+	// 在smb2_seq_num_into_buf()和revert_current_mid_from_hdr()中不处理MessageId
+	rc = cifs_send_recv(xid, ses, server,
+			    &rqst, &resp_buf_type, flags, &rsp_iov);
+	mydebug_print("rc:%d\n", rc);
+	// 如果进程退出了，无法发送cancel请求，需要在工作队列中继续尝试，
+	// 可参考__SMB2_close() -> smb2_handle_cancelled_close() -> __smb2_handle_cancelled_cmd() -> smb2_cancelled_close_fid()
+	/*
+	 * No tcon so can't do
+	 * cifs_stats_inc(&tcon->stats.smb2_stats.smb2_com_fail[SMB2...]);
+	 */
+out:
+	cifs_small_buf_release(req);
+	return rc;
+}
+
 int
 SMB2_change_notify(const unsigned int xid, struct cifs_tcon *tcon,
 		u64 persistent_fid, u64 volatile_fid, bool watch_tree,
 		u32 completion_filter, u32 max_out_data_len, char **out_data,
-		u32 *plen /* returned data len */)
+		u32 *plen, /* returned data len */
+		// 如果除了MessageId外不需要使用其他字段的值，就不用获取整个结构体
+		struct smb2_hdr *req_hdr) /* returned requst header */
 {
 	struct cifs_ses *ses = tcon->ses;
 	struct TCP_Server_Info *server;
@@ -4070,7 +4141,10 @@ SMB2_change_notify(const unsigned int xid, struct cifs_tcon *tcon,
 	int flags = 0;
 	int rc = 0;
 	int retries = 0, cur_sleep = 1;
+	struct smb2_change_notify_req *req;
 
+	if (req_hdr)
+		memset(req_hdr, 0, sizeof(*req_hdr));
 replay_again:
 	/* reinitialize for possible replay */
 	flags = 0;
@@ -4105,6 +4179,13 @@ SMB2_change_notify(const unsigned int xid, struct cifs_tcon *tcon,
 
 	rc = cifs_send_recv(xid, ses, server,
 			    &rqst, &resp_buftype, flags, &rsp_iov);
+	if (req_hdr) {
+		struct smb2_hdr *shdr; // 这个可以删除，只是为了调试查看一些信息
+		shdr = (struct smb2_hdr *)rqst.rq_iov[0].iov_base;
+		req = (struct smb2_change_notify_req *)rqst.rq_iov[0].iov_base;
+		*req_hdr = req->hdr;
+		mydebug_print("req_hdr->MessageId:%llx, shdr->MessageId:%llx\n", req_hdr->MessageId, shdr->MessageId);
+	}
 
 	if (rc != 0) {
 		cifs_stats_fail_inc(tcon, SMB2_CHANGE_NOTIFY_HE);
@@ -4135,6 +4216,7 @@ SMB2_change_notify(const unsigned int xid, struct cifs_tcon *tcon,
 		rc = -ENOMEM;
 		goto cnotify_exit;
 	}
+
 	if (plen)
 		*plen = le32_to_cpu(smb_rsp->OutputBufferLength);
 
@@ -4150,8 +4232,6 @@ SMB2_change_notify(const unsigned int xid, struct cifs_tcon *tcon,
 	return rc;
 }
 
