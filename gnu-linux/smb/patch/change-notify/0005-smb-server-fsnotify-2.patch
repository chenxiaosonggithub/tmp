From da1b921c8f08d477a2b2d54b73d776fede2938dd Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Fri, 29 May 2026 16:46:07 +0800
Subject: [PATCH 5/6] smb/server: fsnotify 2

Signed-off-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/server/notify.c | 241 ++++++++++++++++++++++++++++++++++++-----
 1 file changed, 214 insertions(+), 27 deletions(-)

diff --git a/fs/smb/server/notify.c b/fs/smb/server/notify.c
index c7eabc5d6a71..2bd2fcb0a135 100644
--- a/fs/smb/server/notify.c
+++ b/fs/smb/server/notify.c
@@ -9,6 +9,7 @@
  */
 
 #include <linux/fsnotify_backend.h>
+#include <linux/workqueue.h>
 #include "smb_common.h"
 #include "ksmbd_work.h"
 #include "notify.h"
@@ -24,6 +25,13 @@ struct ksmbd_notify_event {
 	char name[];
 };
 
+struct ksmbd_notify_moved_from {
+	u32 mask;
+	u32 cookie;
+	u32 namelen;
+	char name[];
+};
+
 struct ksmbd_notify_mark {
 	struct fsnotify_mark fsn_mark;
 };
@@ -35,12 +43,30 @@ struct ksmbd_notify_ctx {
 	struct ksmbd_work *work;
 	struct fsnotify_group *group;
 	struct ksmbd_notify_mark *inode_mark;
+	struct ksmbd_notify_moved_from *moved_from;
+	struct delayed_work moved_from_work;
 	u32 completion_filter;
 	u32 output_buffer_length;
 	bool events_ready;
 	bool watching;
 };
 
+static const struct {
+	u32 notify_mask;
+	u32 fsnotify_mask;
+} ksmbd_notify_mapping[] = {
+	{ FILE_NOTIFY_CHANGE_FILE_NAME,
+	  FS_CREATE | FS_DELETE | FS_MOVED_FROM | FS_MOVED_TO },
+	{ FILE_NOTIFY_CHANGE_DIR_NAME,
+	  FS_CREATE | FS_DELETE | FS_MOVED_FROM | FS_MOVED_TO },
+	{ FILE_NOTIFY_CHANGE_ATTRIBUTES,
+	  FS_ATTRIB | FS_MOVED_FROM | FS_MOVED_TO | FS_MODIFY },
+	{ FILE_NOTIFY_CHANGE_LAST_WRITE, FS_ATTRIB },
+	{ FILE_NOTIFY_CHANGE_LAST_ACCESS, FS_ATTRIB },
+	{ FILE_NOTIFY_CHANGE_EA, FS_ATTRIB },
+	{ FILE_NOTIFY_CHANGE_SECURITY, FS_ATTRIB },
+};
+
 static int ksmbd_notify_queue_event(struct ksmbd_notify_ctx *ctx, u32 action,
 				    const struct qstr *file_name)
 {
@@ -70,6 +96,32 @@ static int ksmbd_notify_queue_event(struct ksmbd_notify_ctx *ctx, u32 action,
 	return 0;
 }
 
+static int ksmbd_notify_queue_event_under_lock(struct ksmbd_notify_ctx *ctx,
+					       u32 action,
+					       const struct qstr *file_name)
+{
+	struct ksmbd_notify_event *evt;
+
+	if (!file_name || !file_name->len)
+		return 0;
+
+	evt = kmalloc(struct_size(evt, name, file_name->len + 1), GFP_KERNEL);
+	if (!evt)
+		return -ENOMEM;
+
+	ksmbd_debug(NOTIFY, "action:%d, namelen:%d, name:%s\n",
+		    action, file_name->len, file_name->name);
+	evt->action = action;
+	evt->namelen = file_name->len;
+	memcpy(evt->name, file_name->name, file_name->len);
+	evt->name[file_name->len] = '\0';
+
+	list_add_tail(&evt->list, &ctx->events);
+	ctx->events_ready = true;
+	wake_up(&ctx->waitq);
+	return 0;
+}
+
 static void ksmbd_notify_free_events(struct ksmbd_notify_ctx *ctx)
 {
 	struct ksmbd_notify_event *evt, *tmp;
@@ -80,21 +132,118 @@ static void ksmbd_notify_free_events(struct ksmbd_notify_ctx *ctx)
 	}
 }
 
-static u32 ksmbd_notify_mask_to_action(u32 event_mask, u32 filter, u32 mask)
+static bool ksmbd_notify_filter_match(u32 filter, u32 mask, u32 mark_mask)
+{
+	if ((mask & mark_mask) == 0)
+		return false;
+
+	if (mask & FS_ISDIR)
+		return !!(filter & FILE_NOTIFY_CHANGE_DIR_NAME);
+
+	if ((mask & FS_ATTRIB) &&
+	    (filter & (FILE_NOTIFY_CHANGE_ATTRIBUTES |
+		       FILE_NOTIFY_CHANGE_LAST_WRITE |
+		       FILE_NOTIFY_CHANGE_LAST_ACCESS |
+		       FILE_NOTIFY_CHANGE_EA |
+		       FILE_NOTIFY_CHANGE_SECURITY)))
+		return true;
+
+	if ((mask & FS_MODIFY) && (filter & FILE_NOTIFY_CHANGE_ATTRIBUTES))
+		return true;
+
+	return !!(filter & FILE_NOTIFY_CHANGE_FILE_NAME);
+}
+
+static void ksmbd_notify_trigger_orphaned_moved_from(struct ksmbd_notify_ctx *ctx)
+{
+	struct ksmbd_notify_moved_from *from = ctx->moved_from;
+	struct qstr name;
+
+	if (!from)
+		return;
+
+	name = QSTR_LEN(from->name, from->namelen);
+	if (ksmbd_notify_filter_match(ctx->completion_filter, from->mask,
+				      ctx->inode_mark->fsn_mark.mask))
+		ksmbd_notify_queue_event_under_lock(ctx, FILE_ACTION_REMOVED,
+						    &name);
+
+	kfree(from);
+	ctx->moved_from = NULL;
+}
+
+static void ksmbd_notify_moved_from_timeout(struct work_struct *work)
+{
+	struct ksmbd_notify_ctx *ctx = container_of(work, struct ksmbd_notify_ctx,
+						    moved_from_work.work);
+	unsigned long flags;
+
+	spin_lock_irqsave(&ctx->lock, flags);
+	ksmbd_notify_trigger_orphaned_moved_from(ctx);
+	spin_unlock_irqrestore(&ctx->lock, flags);
+
+	wake_up(&ctx->waitq);
+}
+
+static void ksmbd_notify_save_moved_from(struct ksmbd_notify_ctx *ctx, u32 mask,
+					 u32 cookie, const struct qstr *file_name)
 {
-	if (event_mask & FS_CREATE)
-		return FILE_ACTION_ADDED;
-	if (event_mask & FS_DELETE)
-		return FILE_ACTION_REMOVED;
-	if (event_mask & (FS_MOVED_FROM | FS_RENAME))
-		return FILE_ACTION_RENAMED_OLD_NAME;
-	if (event_mask & (FS_MOVED_TO | FS_RENAME))
-		return FILE_ACTION_RENAMED_NEW_NAME;
-	else
-		return FILE_ACTION_MODIFIED;
+	struct ksmbd_notify_moved_from *from;
 
+	cancel_delayed_work(&ctx->moved_from_work);
+
+	if (ctx->moved_from)
+		ksmbd_notify_trigger_orphaned_moved_from(ctx);
+
+	from = kmalloc(struct_size(from, name, file_name->len + 1), GFP_KERNEL);
+	if (!from)
+		return;
+
+	from->mask = mask;
+	from->cookie = cookie;
+	from->namelen = file_name->len;
+	memcpy(from->name, file_name->name, file_name->len);
+	from->name[file_name->len] = '\0';
+	ctx->moved_from = from;
+
+	schedule_delayed_work(&ctx->moved_from_work, msecs_to_jiffies(100));
+}
+
+static int ksmbd_notify_handle_local_rename(struct ksmbd_notify_ctx *ctx,
+					    u32 mask,
+					    const struct qstr *file_name)
+{
+	struct ksmbd_notify_moved_from *from = ctx->moved_from;
+	struct qstr from_name;
+
+	cancel_delayed_work(&ctx->moved_from_work);
+
+	from_name = QSTR_LEN(from->name, from->namelen);
+
+	if (ksmbd_notify_filter_match(ctx->completion_filter, from->mask,
+				      ctx->inode_mark->fsn_mark.mask))
+		ksmbd_notify_queue_event_under_lock(ctx,
+						    FILE_ACTION_RENAMED_OLD_NAME,
+						    &from_name);
+
+	if (ksmbd_notify_filter_match(ctx->completion_filter, mask,
+				      ctx->inode_mark->fsn_mark.mask))
+		ksmbd_notify_queue_event_under_lock(ctx,
+						    FILE_ACTION_RENAMED_NEW_NAME,
+						    file_name);
+
+	if (!(mask & FS_ISDIR) &&
+	    (ctx->completion_filter & FILE_NOTIFY_CHANGE_CREATION) &&
+	    ksmbd_notify_filter_match(ctx->completion_filter, FS_ATTRIB,
+				      ctx->inode_mark->fsn_mark.mask))
+		ksmbd_notify_queue_event_under_lock(ctx, FILE_ACTION_MODIFIED,
+						    file_name);
+
+	kfree(from);
+	ctx->moved_from = NULL;
 	return 0;
 }
+
 static int ksmbd_notify_handle_event(struct fsnotify_group *group, u32 mask,
 				     const void *data, int data_type,
 				     struct inode *dir,
@@ -102,18 +251,55 @@ static int ksmbd_notify_handle_event(struct fsnotify_group *group, u32 mask,
 				     struct fsnotify_iter_info *iter_info)
 {
 	struct ksmbd_notify_ctx *ctx = group->private;
+	struct ksmbd_notify_mark *imark;
 	u32 event_mask = mask & ALL_FSNOTIFY_EVENTS;
 	u32 action;
+	unsigned long flags;
+	int ret = 0;
 
 	if (!ctx || !ctx->watching)
 		return 0;
 
-	action = ksmbd_notify_mask_to_action(event_mask, ctx->completion_filter,
-					     mask);
-	if (!action)
+	imark = ctx->inode_mark;
+	if (!imark || (event_mask & imark->fsn_mark.mask) == 0)
+		return 0;
+
+	if ((event_mask & (FS_ATTRIB | FS_MODIFY | FS_CREATE | FS_DELETE |
+			   FS_MOVED_FROM | FS_MOVED_TO)) == 0)
 		return 0;
 
-	return ksmbd_notify_queue_event(ctx, action, file_name);
+	spin_lock_irqsave(&ctx->lock, flags);
+
+	if (event_mask & FS_MOVED_FROM) {
+		if (file_name && file_name->len)
+			ksmbd_notify_save_moved_from(ctx, mask, cookie,
+						     file_name);
+		goto out_unlock;
+	}
+
+	if (event_mask & FS_MOVED_TO) {
+		if (ctx->moved_from && ctx->moved_from->cookie == cookie) {
+			ret = ksmbd_notify_handle_local_rename(ctx, mask,
+							       file_name);
+			goto out_unlock;
+		}
+		action = FILE_ACTION_ADDED;
+	} else if (event_mask & FS_CREATE) {
+		action = FILE_ACTION_ADDED;
+	} else if (event_mask & FS_DELETE) {
+		action = FILE_ACTION_REMOVED;
+	} else {
+		action = FILE_ACTION_MODIFIED;
+	}
+
+	if (ksmbd_notify_filter_match(ctx->completion_filter, mask,
+				      imark->fsn_mark.mask))
+		ret = ksmbd_notify_queue_event_under_lock(ctx, action,
+							  file_name);
+
+out_unlock:
+	spin_unlock_irqrestore(&ctx->lock, flags);
+	return ret;
 }
 
 static void ksmbd_notify_free_mark(struct fsnotify_mark *fsn_mark)
@@ -131,20 +317,13 @@ static const struct fsnotify_ops ksmbd_notify_fsnotify_ops = {
 
 static u32 ksmbd_notify_filter_to_mask(u32 filter)
 {
+	size_t i;
 	u32 mask = FS_EVENT_ON_CHILD;
 
-	if (filter & (FILE_NOTIFY_CHANGE_FILE_NAME |
-		      FILE_NOTIFY_CHANGE_DIR_NAME))
-		mask |= FS_CREATE | FS_DELETE | FS_MOVED_FROM | FS_MOVED_TO;
-
-	if (filter & FILE_NOTIFY_CHANGE_ATTRIBUTES)
-		mask |= FS_ATTRIB | FS_MOVED_FROM | FS_MOVED_TO | FS_MODIFY;
-
-	if (filter & (FILE_NOTIFY_CHANGE_LAST_WRITE |
-		      FILE_NOTIFY_CHANGE_LAST_ACCESS |
-		      FILE_NOTIFY_CHANGE_EA |
-		      FILE_NOTIFY_CHANGE_SECURITY))
-		mask |= FS_ATTRIB;
+	for (i = 0; i < ARRAY_SIZE(ksmbd_notify_mapping); i++) {
+		if (ksmbd_notify_mapping[i].notify_mask & filter)
+			mask |= ksmbd_notify_mapping[i].fsnotify_mask;
+	}
 
 	return mask;
 }
@@ -189,9 +368,16 @@ static void ksmbd_notify_unwatch(struct ksmbd_notify_ctx *ctx)
 {
 	struct fsnotify_group *group = ctx->group;
 	struct ksmbd_notify_mark *imark = ctx->inode_mark;
+	unsigned long flags;
 
 	ctx->watching = false;
 
+	cancel_delayed_work_sync(&ctx->moved_from_work);
+
+	spin_lock_irqsave(&ctx->lock, flags);
+	ksmbd_notify_trigger_orphaned_moved_from(ctx);
+	spin_unlock_irqrestore(&ctx->lock, flags);
+
 	if (!group)
 		return;
 
@@ -298,6 +484,7 @@ int smb2_setup_notify(struct ksmbd_work *work,
 	init_waitqueue_head(&ctx->waitq);
 	spin_lock_init(&ctx->lock);
 	INIT_LIST_HEAD(&ctx->events);
+	INIT_DELAYED_WORK(&ctx->moved_from_work, ksmbd_notify_moved_from_timeout);
 	ctx->work = work;
 	ctx->completion_filter = le32_to_cpu(req->CompletionFilter);
 	ctx->output_buffer_length = le32_to_cpu(req->OutputBufferLength);
-- 
2.54.0

