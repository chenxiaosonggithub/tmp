From f994a648de20ddc93d529ace1bdf316c16171920 Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Sun, 4 Jan 2026 19:17:30 +0800
Subject: [PATCH] smb/server: return test filename in smb2_test_notify()

Signed-off-by: ChenXiaoSong <chenxiaosong@kylinos.cn>
---
 fs/smb/server/Makefile  |  2 +-
 fs/smb/server/notify.c  | 58 +++++++++++++++++++++++++++++++++++++++++
 fs/smb/server/notify.h  | 18 +++++++++++++
 fs/smb/server/smb2pdu.c | 55 +++++++++++++++++++++++++++++++++-----
 4 files changed, 126 insertions(+), 7 deletions(-)
 create mode 100644 fs/smb/server/notify.c
 create mode 100644 fs/smb/server/notify.h

diff --git a/fs/smb/server/Makefile b/fs/smb/server/Makefile
index 7d6337a7dee4..2307aca0d61e 100644
--- a/fs/smb/server/Makefile
+++ b/fs/smb/server/Makefile
@@ -10,7 +10,7 @@ ksmbd-y :=	unicode.o auth.o vfs.o vfs_cache.o server.o ndr.o \
 		mgmt/tree_connect.o mgmt/user_session.o smb_common.o \
 		transport_tcp.o transport_ipc.o smbacl.o smb2pdu.o \
 		smb2ops.o smb2misc.o ksmbd_spnego_negtokeninit.asn1.o \
-		ksmbd_spnego_negtokentarg.asn1.o asn1.o
+		ksmbd_spnego_negtokentarg.asn1.o asn1.o notify.o
 
 $(obj)/asn1.o: $(obj)/ksmbd_spnego_negtokeninit.asn1.h $(obj)/ksmbd_spnego_negtokentarg.asn1.h
 
diff --git a/fs/smb/server/notify.c b/fs/smb/server/notify.c
new file mode 100644
index 000000000000..0f8e9cee7c12
--- /dev/null
+++ b/fs/smb/server/notify.c
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ *
+ *   SMB2 CHANGE_NOTIFY
+ *
+ *   Copyright (C) 2026 KylinSoft Co., Ltd. All rights reserved.
+ *   Author(s): ChenXiaoSong <chenxiaosong@kylinos.cn>
+ *
+ */
+
+#include "smb_common.h"
+#include "ksmbd_work.h"
+#include "notify.h"
+#include "../common/smb2status.h"
+#include "connection.h"
+
+#define NOTIFY_TEST_TODO	1
+
+#if NOTIFY_TEST_TODO
+static int smb2_test_notify(struct ksmbd_work *work,
+			    struct smb2_change_notify_rsp *rsp)
+{
+	int rc = 0;
+
+	struct ksmbd_conn *conn = work->conn;
+	struct file_notify_information *info;
+	char test_filename[] = "test-file";
+	size_t name_len;
+
+	info = (struct file_notify_information *)rsp->Buffer;
+	name_len = smbConvertToUTF16((__le16 *)info->FileName,
+				     test_filename, sizeof(test_filename),
+				     conn->local_nls, 0);
+	name_len *= 2;
+	info->NextEntryOffset = cpu_to_le32(0); /* Last entry */
+	info->Action = cpu_to_le32(FILE_ACTION_ADDED);
+	info->FileNameLength = cpu_to_le32(name_len);
+
+	rsp->StructureSize = cpu_to_le16(9);
+	rsp->OutputBufferOffset = cpu_to_le16(sizeof(struct smb2_change_notify_rsp));
+	rsp->OutputBufferLength = cpu_to_le32(sizeof(struct file_notify_information) + name_len);
+	rc = ksmbd_iov_pin_rsp(work, rsp, le16_to_cpu(rsp->OutputBufferOffset) +
+					  le32_to_cpu(rsp->OutputBufferLength));
+
+	return rc;
+}
+#endif
+
+int smb2_setup_notify(struct ksmbd_work *work,
+		      struct smb2_change_notify_req *req,
+		      struct smb2_change_notify_rsp *rsp)
+{
+	int rc = 0;
+
+	rc = smb2_test_notify(work, rsp);
+
+	return rc;
+}
diff --git a/fs/smb/server/notify.h b/fs/smb/server/notify.h
new file mode 100644
index 000000000000..1d4123a51762
--- /dev/null
+++ b/fs/smb/server/notify.h
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ *
+ *   SMB2 CHANGE_NOTIFY header
+ *
+ *   Copyright (C) 2026 KylinSoft Co., Ltd. All rights reserved.
+ *   Author(s): ChenXiaoSong <chenxiaosong@kylinos.cn>
+ *
+ */
+
+#ifndef __SMB_SERVER_NOTIFY_H__
+#define __SMB_SERVER_NOTIFY_H__
+
+int smb2_setup_notify(struct ksmbd_work *work,
+		      struct smb2_change_notify_req *req,
+		      struct smb2_change_notify_rsp *rsp);
+
+#endif /* __SMB_SERVER_NOTIFY_H__ */
diff --git a/fs/smb/server/smb2pdu.c b/fs/smb/server/smb2pdu.c
index 2fcd0d4d1fb0..71baf3b0689b 100644
--- a/fs/smb/server/smb2pdu.c
+++ b/fs/smb/server/smb2pdu.c
@@ -40,6 +40,7 @@
 #include "mgmt/ksmbd_ida.h"
 #include "ndr.h"
 #include "transport_tcp.h"
+#include "notify.h"
 
 static void __wbuf(struct ksmbd_work *work, void **req, void **rsp)
 {
@@ -533,7 +534,8 @@ int smb2_allocate_rsp_buf(struct ksmbd_work *work)
 	size_t sz = small_sz;
 	int cmd = le16_to_cpu(hdr->Command);
 
-	if (cmd == SMB2_IOCTL_HE || cmd == SMB2_QUERY_DIRECTORY_HE)
+	if (cmd == SMB2_IOCTL_HE || cmd == SMB2_QUERY_DIRECTORY_HE ||
+	    cmd == SMB2_CHANGE_NOTIFY_HE)
 		sz = large_sz;
 
 	if (cmd == SMB2_QUERY_INFO_HE) {
@@ -8796,8 +8798,11 @@ int smb2_oplock_break(struct ksmbd_work *work)
  */
 int smb2_notify(struct ksmbd_work *work)
 {
+	int rc = 0;
 	struct smb2_change_notify_req *req;
 	struct smb2_change_notify_rsp *rsp;
+	struct ksmbd_file *dir_fp = NULL;
+	struct inode *dir_inode;
 
 	ksmbd_debug(SMB, "Received smb2 notify\n");
 
@@ -8805,13 +8810,51 @@ int smb2_notify(struct ksmbd_work *work)
 
 	if (work->next_smb2_rcv_hdr_off && req->hdr.NextCommand) {
 		rsp->hdr.Status = STATUS_INTERNAL_ERROR;
-		smb2_set_err_rsp(work);
-		return -EIO;
+		rc = -EIO;
+		goto out;
 	}
 
-	smb2_set_err_rsp(work);
-	rsp->hdr.Status = STATUS_NOT_IMPLEMENTED;
-	return -EOPNOTSUPP;
+	if (le16_to_cpu(req->StructureSize) != 32) {
+		pr_err("Invalid structure size for change notify\n");
+		rsp->hdr.Status = STATUS_INVALID_PARAMETER;
+		rc = -EINVAL;
+		goto out;
+	}
+
+	// TODO: ksmbd_lookup_fd_fast?
+	dir_fp = ksmbd_lookup_fd_slow(work, req->VolatileFileId,
+				      req->PersistentFileId);
+	if (!dir_fp) {
+		pr_err("Invalid file handle for change notify\n");
+		rsp->hdr.Status = STATUS_INVALID_HANDLE;
+		rc = -EBADF;
+		goto out;
+	}
+
+	dir_inode = file_inode(dir_fp->filp);
+	if (!S_ISDIR(dir_inode->i_mode)) {
+		pr_err("Change notify only works on directories\n");
+		rsp->hdr.Status = STATUS_INVALID_PARAMETER;
+		rc = -EINVAL;
+		goto out;
+	}
+
+	rc = smb2_setup_notify(work, req, rsp);
+	if (rc) {
+		pr_err("Failed to setup notify: %d\n", rc);
+		rsp->hdr.Status = STATUS_INTERNAL_ERROR;
+		goto out;
+	}
+
+	rsp->hdr.Status = STATUS_SUCCESS;
+out:
+	if (rc)
+		smb2_set_err_rsp(work);
+
+	if (dir_fp)
+		ksmbd_fd_put(work, dir_fp);
+
+	return rc;
 }
 
 /**
