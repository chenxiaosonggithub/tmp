From 99dcdb4d1d4b15c6e2e5277407e73e30c5394229 Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Fri, 6 Nov 2026 10:49:18 +0800
Subject: [PATCH 15/39] smb/client: move NTLMSSP AV type macros to
 common/ntlmssp.h

Move the NTLMSSP AV type macros from smb1pdu.h to the common NTLMSSP
header alongside the AV pair definitions.

Prepared with assistance from OpenAI Codex.
---
 fs/smb/client/smb1pdu.h | 8 --------
 fs/smb/common/ntlmssp.h | 8 ++++++++
 2 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/fs/smb/client/smb1pdu.h b/fs/smb/client/smb1pdu.h
index 5589789a327f..52a6812ff22c 100644
--- a/fs/smb/client/smb1pdu.h
+++ b/fs/smb/client/smb1pdu.h
@@ -489,14 +489,6 @@ typedef union smb_com_session_setup_andx {
 	} __packed old_resp; /* pre-NTLM (LANMAN2.1) response */
 } __packed SESSION_SETUP_ANDX;
 
-/* format of NLTMv2 Response ie "case sensitive password" hash when NTLMv2 */
-
-#define NTLMSSP_SERVER_TYPE	1
-#define NTLMSSP_DOMAIN_TYPE	2
-#define NTLMSSP_FQ_DOMAIN_TYPE	3
-#define NTLMSSP_DNS_DOMAIN_TYPE	4
-#define NTLMSSP_DNS_PARENT_TYPE	5
-
 struct ntlmv2_resp {
 	union {
 	    char ntlmv2_hash[CIFS_ENCPWD_SIZE];
diff --git a/fs/smb/common/ntlmssp.h b/fs/smb/common/ntlmssp.h
index 4014286d101c..a611ab98283f 100644
--- a/fs/smb/common/ntlmssp.h
+++ b/fs/smb/common/ntlmssp.h
@@ -127,6 +127,14 @@ struct challenge_message {
 	 */
 } __packed;
 
+/* format of NLTMv2 Response ie "case sensitive password" hash when NTLMv2 */
+
+#define NTLMSSP_SERVER_TYPE	1
+#define NTLMSSP_DOMAIN_TYPE	2
+#define NTLMSSP_FQ_DOMAIN_TYPE	3
+#define NTLMSSP_DNS_DOMAIN_TYPE	4
+#define NTLMSSP_DNS_PARENT_TYPE	5
+
 struct ntlmssp2_name {
 	__le16 type;
 	__le16 length;
-- 
