From ee23e8ee762c190a24094860b26ca04eaf13857d Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Fri, 6 Nov 2026 10:49:19 +0800
Subject: [PATCH 23/39] smb: move NTFS_TIME_OFFSET to common/smbglob.h

The client and server use the same offset between the NT and Unix
epochs. Move the duplicate definition to the common header file.

Prepared with assistance from OpenAI Codex.
---
 fs/smb/client/netmisc.c | 2 --
 fs/smb/common/smbglob.h | 3 +++
 fs/smb/server/misc.h    | 1 -
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/fs/smb/client/netmisc.c b/fs/smb/client/netmisc.c
index cf737ede1ab3..0f6c1279b0ba 100644
--- a/fs/smb/client/netmisc.c
+++ b/fs/smb/client/netmisc.c
@@ -109,8 +109,6 @@ cifs_set_port(struct sockaddr *addr, const unsigned short int port)
 
 /* The following are taken from fs/ntfs/util.c */
 
-#define NTFS_TIME_OFFSET ((u64)(369*365 + 89) * 24 * 3600 * 10000000)
-
 /*
  * Convert the NT UTC (based 1601-01-01, in hundred nanosecond units)
  * into Unix UTC (based 1970-01-01, in seconds).
diff --git a/fs/smb/common/smbglob.h b/fs/smb/common/smbglob.h
index fdf840888062..5a05423a5eb2 100644
--- a/fs/smb/common/smbglob.h
+++ b/fs/smb/common/smbglob.h
@@ -66,6 +66,9 @@ static inline void inc_rfc1001_len(void *buf, int count)
 
 #define CIFS_DEFAULT_IOSIZE (1024 * 1024)
 
+/* Difference between the NT and Unix epochs, in 100-nanosecond units. */
+#define NTFS_TIME_OFFSET	((u64)(369 * 365 + 89) * 24 * 3600 * 10000000)
+
 #define MAX_CIFS_SMALL_BUFFER_SIZE 448 /* big enough for most */
 
 #endif	/* _COMMON_SMB_GLOB_H */
diff --git a/fs/smb/server/misc.h b/fs/smb/server/misc.h
index 1faaddd0f5f7..1223f5ae98ac 100644
--- a/fs/smb/server/misc.h
+++ b/fs/smb/server/misc.h
@@ -32,7 +32,6 @@ char *ksmbd_convert_dir_info_name(struct ksmbd_dir_info *d_info,
 				  const struct nls_table *local_nls,
 				  int *conv_len);
 
-#define NTFS_TIME_OFFSET	((u64)(369 * 365 + 89) * 24 * 3600 * 10000000)
 struct timespec64 ksmbd_NTtimeToUnix(__le64 ntutc);
 u64 ksmbd_UnixTimeToNT(struct timespec64 t);
 long long ksmbd_systime(void);
-- 
2.53.0

