From dd50369cec4e4bb56c319dfb0f39e6b8279c72fb Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Fri, 6 Nov 2026 10:49:21 +0800
Subject: [PATCH 30/39] smb: move file_id_64_extd_directory_info to
 common/fscc.h

smb2_file_id_extd_directory_info and file_id_64_extd_directory_info
describe the same directory information layout with a 64-bit file ID.
Remove the unused client definition and move the server definition to
the common header file.

Prepared with assistance from OpenAI Codex.
---
 fs/smb/client/smb2pdu.h    | 18 ------------------
 fs/smb/common/fscc.h       | 18 ++++++++++++++++++
 fs/smb/server/smb_common.h | 18 ------------------
 3 files changed, 18 insertions(+), 36 deletions(-)

diff --git a/fs/smb/client/smb2pdu.h b/fs/smb/client/smb2pdu.h
index 369bef19a4fe..0a47e347f63b 100644
--- a/fs/smb/client/smb2pdu.h
+++ b/fs/smb/client/smb2pdu.h
@@ -198,24 +198,6 @@ struct smb2_file_id_information {
 	__u64  VolatileFileId; /* opaque endianness */
 } __packed; /* level 59 */
 
-/* See MS-FSCC 2.4.18 */
-struct smb2_file_id_extd_directory_info {
-	__le32 NextEntryOffset;
-	__u32 FileIndex;
-	__le64 CreationTime;
-	__le64 LastAccessTime;
-	__le64 LastWriteTime;
-	__le64 ChangeTime;
-	__le64 EndOfFile;
-	__le64 AllocationSize;
-	__le32 FileAttributes;
-	__le32 FileNameLength;
-	__le32 EaSize; /* EA size */
-	__le32 ReparsePointTag; /* valid if FILE_ATTR_REPARSE_POINT set in FileAttributes */
-	__le64 UniqueId; /* inode num - le since Samba puts ino in low 32 bit */
-	char FileName[];
-} __packed; /* level 60 */
-
 extern char smb2_padding[7];
 
 /*
diff --git a/fs/smb/common/fscc.h b/fs/smb/common/fscc.h
index 9236ba58f8b1..75bb0e8eb04f 100644
--- a/fs/smb/common/fscc.h
+++ b/fs/smb/common/fscc.h
@@ -344,6 +344,24 @@ struct smb2_file_full_ea_info {
 	char   ea_data[]; /* NUL-terminated name followed by value */
 } __packed;
 
+/* MS-FSCC 2.4.19 FileId64ExtdDirectoryInformation */
+struct file_id_64_extd_directory_info {
+	__le32 NextEntryOffset;
+	__u32 FileIndex;
+	__le64 CreationTime;
+	__le64 LastAccessTime;
+	__le64 LastWriteTime;
+	__le64 ChangeTime;
+	__le64 EndOfFile;
+	__le64 AllocationSize;
+	__le32 ExtFileAttributes;
+	__le32 FileNameLength;
+	__le32 EaSize;
+	__le32 ReparsePointTag;
+	__le64 FileId;
+	char FileName[];
+} __packed;
+
 /* See MS-FSCC 2.4.24 */
 typedef struct {
 	__le32 NextEntryOffset;
diff --git a/fs/smb/server/smb_common.h b/fs/smb/server/smb_common.h
index c778da14f71e..de42dbe4fb4f 100644
--- a/fs/smb/server/smb_common.h
+++ b/fs/smb/server/smb_common.h
@@ -136,24 +136,6 @@ struct file_id_extd_directory_info {
 	char FileName[];
 } __packed;
 
-/* MS-FSCC 2.4.19 FileId64ExtdDirectoryInformation */
-struct file_id_64_extd_directory_info {
-	__le32 NextEntryOffset;
-	__u32 FileIndex;
-	__le64 CreationTime;
-	__le64 LastAccessTime;
-	__le64 LastWriteTime;
-	__le64 ChangeTime;
-	__le64 EndOfFile;
-	__le64 AllocationSize;
-	__le32 ExtFileAttributes;
-	__le32 FileNameLength;
-	__le32 EaSize;
-	__le32 ReparsePointTag;
-	__le64 FileId;
-	char FileName[];
-} __packed;
-
 /* MS-FSCC 2.4.18 FileId64ExtdBothDirectoryInformation */
 struct file_id_64_extd_both_directory_info {
 	__le32 NextEntryOffset;
-- 
2.53.0

