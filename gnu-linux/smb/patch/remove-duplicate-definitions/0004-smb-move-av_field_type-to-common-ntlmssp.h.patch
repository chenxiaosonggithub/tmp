From 8702b4971e3f8a918bf172091c40c7f8edf273bb Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Fri, 6 Nov 2026 10:49:18 +0800
Subject: [PATCH 04/39] smb: move av_field_type to common/ntlmssp.h

The client and server define the same NTLMSSP AV pair identifiers.
Move the duplicate enum definition to the common header file.

Prepared with assistance from OpenAI Codex.
---
 fs/smb/client/ntlmssp.h | 15 ---------------
 fs/smb/common/ntlmssp.h | 15 +++++++++++++++
 fs/smb/server/ntlmssp.h | 15 ---------------
 3 files changed, 15 insertions(+), 30 deletions(-)

diff --git a/fs/smb/client/ntlmssp.h b/fs/smb/client/ntlmssp.h
index e1715290c385..0cd0ba52806d 100644
--- a/fs/smb/client/ntlmssp.h
+++ b/fs/smb/client/ntlmssp.h
@@ -11,21 +11,6 @@
 
 #include "../common/ntlmssp.h"
 
-/* Define AV Pair Field IDs */
-enum av_field_type {
-	NTLMSSP_AV_EOL = 0,
-	NTLMSSP_AV_NB_COMPUTER_NAME,
-	NTLMSSP_AV_NB_DOMAIN_NAME,
-	NTLMSSP_AV_DNS_COMPUTER_NAME,
-	NTLMSSP_AV_DNS_DOMAIN_NAME,
-	NTLMSSP_AV_DNS_TREE_NAME,
-	NTLMSSP_AV_FLAGS,
-	NTLMSSP_AV_TIMESTAMP,
-	NTLMSSP_AV_RESTRICTION,
-	NTLMSSP_AV_TARGET_NAME,
-	NTLMSSP_AV_CHANNEL_BINDINGS
-};
-
 /* Although typedefs are not commonly used for structure definitions */
 /* in the Linux kernel, in this particular case they are useful      */
 /* to more closely match the standards document for NTLMSSP from     */
diff --git a/fs/smb/common/ntlmssp.h b/fs/smb/common/ntlmssp.h
index 966467280251..0c407814315e 100644
--- a/fs/smb/common/ntlmssp.h
+++ b/fs/smb/common/ntlmssp.h
@@ -53,4 +53,19 @@
 #define NTLMSSP_NEGOTIATE_KEY_XCH   0x40000000
 #define NTLMSSP_NEGOTIATE_56        0x80000000
 
+/* Define AV Pair Field IDs */
+enum av_field_type {
+	NTLMSSP_AV_EOL = 0,
+	NTLMSSP_AV_NB_COMPUTER_NAME,
+	NTLMSSP_AV_NB_DOMAIN_NAME,
+	NTLMSSP_AV_DNS_COMPUTER_NAME,
+	NTLMSSP_AV_DNS_DOMAIN_NAME,
+	NTLMSSP_AV_DNS_TREE_NAME,
+	NTLMSSP_AV_FLAGS,
+	NTLMSSP_AV_TIMESTAMP,
+	NTLMSSP_AV_RESTRICTION,
+	NTLMSSP_AV_TARGET_NAME,
+	NTLMSSP_AV_CHANNEL_BINDINGS
+};
+
 #endif /* _COMMON_NTLMSSP_H */
diff --git a/fs/smb/server/ntlmssp.h b/fs/smb/server/ntlmssp.h
index e1fcb8c3de09..0ee95367e58f 100644
--- a/fs/smb/server/ntlmssp.h
+++ b/fs/smb/server/ntlmssp.h
@@ -24,21 +24,6 @@
 #define CIFS_ENCPWD_SIZE	(16)
 #define CIFS_CPHTXT_SIZE	(16)
 
-/* Define AV Pair Field IDs */
-enum av_field_type {
-	NTLMSSP_AV_EOL = 0,
-	NTLMSSP_AV_NB_COMPUTER_NAME,
-	NTLMSSP_AV_NB_DOMAIN_NAME,
-	NTLMSSP_AV_DNS_COMPUTER_NAME,
-	NTLMSSP_AV_DNS_DOMAIN_NAME,
-	NTLMSSP_AV_DNS_TREE_NAME,
-	NTLMSSP_AV_FLAGS,
-	NTLMSSP_AV_TIMESTAMP,
-	NTLMSSP_AV_RESTRICTION,
-	NTLMSSP_AV_TARGET_NAME,
-	NTLMSSP_AV_CHANNEL_BINDINGS
-};
-
 /* Although typedefs are not commonly used for structure definitions */
 /* in the Linux kernel, in this particular case they are useful      */
 /* to more closely match the standards document for NTLMSSP from     */
