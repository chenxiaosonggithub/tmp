 	__le64 IndexNumber;
 	__le32 Tag;
@@ -288,12 +280,6 @@ struct smb2_posix_info_parsed {
 	const u8 *name;
 };
 
-struct smb2_create_ea_ctx {
-	struct create_context_hdr ctx;
-	__u8 name[8];
-	struct smb2_file_full_ea_info ea;
-} __packed;
-
