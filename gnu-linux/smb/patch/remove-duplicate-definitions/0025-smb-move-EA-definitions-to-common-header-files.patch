 #define SMB2_WSL_XATTR_GID		"$LXGID"
 #define SMB2_WSL_XATTR_MODE		"$LXMOD"
diff --git a/fs/smb/common/fscc.h b/fs/smb/common/fscc.h
index 00f09e1a3afe..cc04b9fa7e1e 100644
--- a/fs/smb/common/fscc.h
+++ b/fs/smb/common/fscc.h
@@ -319,6 +319,15 @@ typedef struct {
 	char FileName[];
 } __packed FILE_FULL_DIRECTORY_INFO; /* level 0x102 rsp data */
 
+/* See MS-FSCC 2.4.16 */
+struct smb2_file_full_ea_info {
+	__le32 next_entry_offset;
+	__u8   flags;
+	__u8   ea_name_length;
+	__le16 ea_value_length;
+	char   ea_data[]; /* NUL-terminated name followed by value */
+} __packed;
+
 /* See MS-FSCC 2.4.24 */
 typedef struct {
 	__le32 NextEntryOffset;
diff --git a/fs/smb/common/smb2pdu.h b/fs/smb/common/smb2pdu.h
