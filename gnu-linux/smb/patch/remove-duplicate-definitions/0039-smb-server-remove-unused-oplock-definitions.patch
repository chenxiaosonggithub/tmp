From 4daccfef4c781b6f4a419ff884e61dba33e52dea Mon Sep 17 00:00:00 2001
From: ChenXiaoSong <chenxiaosong@kylinos.cn>
Date: Fri, 6 Nov 2026 10:49:23 +0800
Subject: [PATCH 39/39] smb/server: remove unused oplock definitions

The OPLOCK_NONE, OPLOCK_EXCLUSIVE, OPLOCK_BATCH and OPLOCK_READ
definitions in vfs_cache.c are not used. Remove these duplicate
definitions.

Prepared with assistance from OpenAI Codex.
---
 fs/smb/server/vfs_cache.c | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/fs/smb/server/vfs_cache.c b/fs/smb/server/vfs_cache.c
index f9079c529d07..6a625240c996 100644
--- a/fs/smb/server/vfs_cache.c
+++ b/fs/smb/server/vfs_cache.c
@@ -116,11 +116,6 @@ static DEFINE_HASHTABLE(file_locks, 8);
 
 static int ksmbd_mark_fp_closed(struct ksmbd_file *fp);
 
-#define OPLOCK_NONE      0
-#define OPLOCK_EXCLUSIVE 1
-#define OPLOCK_BATCH     2
-#define OPLOCK_READ      3  /* level 2 oplock */
-
 #ifdef CONFIG_PROC_FS
 
 static const struct ksmbd_const_name ksmbd_lease_const_names[] = {
